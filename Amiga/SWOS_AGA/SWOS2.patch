+; --------------------------------------------------------------------------
+; WriteCopperPalette
+; Patch palette VALUE words in copperListBuffer using fixed offsets (no scan).
+;
+; In:
+;   A0 = 256-word palette (8 banks x 32 colors) in $0RGB format
+;
+; Trashes:
+;   D0-D2, A1-A3
+; --------------------------------------------------------------------------
+WriteCopperPalette:
+                lea     (copperListBuffer).l,a1
+
+                lea     COP_PAL_B0_C0_VAL_OFF(a1),a2
+                movea.l a0,a3
+                bsr.w   .PatchBank_ValPtr
+
+                lea     COP_PAL_B1_C0_VAL_OFF(a1),a2
+                lea     64(a0),a3
+                bsr.w   .PatchBank_ValPtr
+
+                lea     COP_PAL_B2_C0_VAL_OFF(a1),a2
+                lea     128(a0),a3
+                bsr.w   .PatchBank_ValPtr
+
+                lea     COP_PAL_B3_C0_VAL_OFF(a1),a2
+                lea     192(a0),a3
+                bsr.w   .PatchBank_ValPtr
+
+                lea     COP_PAL_B4_C0_VAL_OFF(a1),a2
+                lea     256(a0),a3
+                bsr.w   .PatchBank_ValPtr
+
+                lea     COP_PAL_B5_C0_VAL_OFF(a1),a2
+                lea     320(a0),a3
+                bsr.w   .PatchBank_ValPtr
+
+                lea     COP_PAL_B6_C0_VAL_OFF(a1),a2
+                lea     384(a0),a3
+                bsr.w   .PatchBank_ValPtr
+
+                lea     COP_PAL_B7_C0_VAL_OFF(a1),a2
+                lea     448(a0),a3
+                bsr.w   .PatchBank_ValPtr
+
+                rts
+
+.PatchBank_ValPtr:
+                moveq   #31,d0
+.loop:
+                move.w  (a3)+,(a2)
+                adda.l  #4,a2
+                dbf     d0,.loop
+                rts
+
+; Bank layout includes WAIT pairs in slots 7 and 8 (do not touch their VALUE words).
+; We still advance A2 by 4 and A3 by 1 word for those slots to keep alignment.
+.PatchBank_Skip7_8:
+                moveq   #31,d0                  ; slot index 31..0 with DBF, we want 0..31
+                moveq   #0,d2                   ; slot counter 0..31
+.p1_loop:
+                move.w  (a3)+,d1                ; next palette word
+
+                cmpi.w  #7,d2
+                beq.s   .p1_skip_write
+                cmpi.w  #8,d2
+                beq.s   .p1_skip_write
+
+                move.w  d1,2(a2)                ; patch VALUE (non-WAIT slot)
+
+.p1_skip_write:
+                adda.l  #4,a2                   ; next copper pair slot
+                addq.w  #1,d2
+                dbf     d0,.p1_loop
+                rts
+
+; --------------------------------------------------------------------------
+; WriteCopperPitchPalette
+; Build/update gamePalette[256] by applying 9 pitch-specific entries, then
+; push gamePalette into the copper buffer using WriteCopperPalette.
+;
+; Uses:
+;   pitchNumberAndType (word) as index 0..6 into pitchPalettePtrs (clamped)
+;   paletteIndices     (9 bytes) as destination indices into gamePalette
+;   pitchPalettePtrs   (7 longwords) -> each points to 9-word palette
+;
+; Trashes:
+;   D0-D3/D7, A0-A3
+; --------------------------------------------------------------------------
+WriteCopperPitchPalette:
+                ; --- select pitch palette pointer ---
+                move.w  (pitchNumberAndType).l,d0
+                cmpi.w  #6,d0
+                bls.s   .idx_ok
+                moveq   #4,d0                   ; default to "normal" if out of range
+.idx_ok:
+                lsl.w   #2,d0                   ; longword index
+                lea     (pitchPalettePtrs).l,a2
+                movea.l (a2,d0.w),a2            ; A2 = selected 9-word pitch palette
+
+                ; --- apply 9 entries into gamePalette ---
+                lea     (paletteIndices).l,a1   ; bytes: 0..255
+                lea     (gamePalette).l,a3      ; destination 256-word table
+
+                moveq   #8,d7                   ; 9 entries (0..8)
+.apply_loop:
+                moveq   #0,d1
+                move.b  (a1)+,d1                ; d1 = palette index (0..255)
+                lsl.w   #1,d1                   ; word offset (idx*2)
+
+                move.w  (a2)+,d2                ; next pitch color word
+                move.w  d2,(a3,d1.w)            ; gamePalette[idx] = color
+
+                dbf     d7,.apply_loop
+
+                ; --- push full 256-color gamePalette into copper buffer ---
+                lea     (gamePalette).l,a0
+                bsr.w   WriteCopperPalette
+                rts
+
