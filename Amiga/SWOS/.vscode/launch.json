{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "FS-UAE Debug",
            "stopOnEntry": false,
            "program": "${workspaceFolder}/uae/dh0/data/SWOS2",
            "remoteProgram": "SYS:data/SWOS2",
            "emulatorType": "fs-uae",
            "emulatorArgs": [
                "--amiga_model=A1200/020",
                "--cpu=68020",
                "--fpu=none",
                "--chip_memory=2",
                "--fast_memory=8",

                "--hard_drive_0=${workspaceFolder}/uae/dh0",
                "--automatic_input_grab=0",
                "--save_states=0",
            ],
            "preLaunchTask": "amigaassembly: build"
        },
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "WinUAE Debug",
            "stopOnEntry": false,
            "program": "${workspaceFolder}/uae/dh0/data/SWOS2",
            "remoteProgram": "SYS:data/SWOS2",
            "emulatorType": "winuae",
            "emulatorArgs": [
                "-s", "quickstart=a1200/020",
                "-s", "cpu_type=68020",
                "-s", "cpu_compatible=true",
                "-s", "fpu_model=none",
                "-s", "kickstart_rom_file=C:\\Projects\\Amiga\\Kickstarts\\KICK31_A1200.rom",

                "-s", "chipmem_size=2048",
                "-s", "fastmem_size=8192",

                "-s","filesystem2=rw,DH0:${workspaceFolder}\\uae\\dh0,0",

                "-s", "joyport1=kbd2",
            ],
            "preLaunchTask": "amigaassembly: build"
        },
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "FS-UAE Launch",
            "noDebug": true,
            "program": "${workspaceFolder}/uae/dh0/data/SWOS2",
            "remoteProgram": "SYS:data/SWOS2",
            "emulatorType": "fs-uae",
            "emulatorArgs": [
                "--amiga_model=A1200/020",
                "--cpu=68020",
                "--fpu=none",
                "--cpu_compatible=1",
                "--chip_memory=2",
                "--fast_memory=8",

                "--hard_drive_0=${workspaceFolder}/uae/dh0",
                "--automatic_input_grab=0",
                "--save_states=0",
            ],
            "preLaunchTask": "amigaassembly: build"
        },
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "WinUAE Launch",
            "noDebug": true,
            "program": "${workspaceFolder}/uae/dh0/data/SWOS2",
            "remoteProgram": "SYS:data/SWOS2",
            "emulatorType": "winuae",
            "emulatorArgs": [
                "-s", "quickstart=a1200/020",
                "-s", "cpu_type=68020",
                "-s", "cpu_compatible=true",
                "-s", "fpu_model=none",
                "-s", "kickstart_rom_file=./Kickstarts/Kickstart v3.1 rev 40.68 (1993)(Commodore)(A1200).rom",

                "-s", "chipmem_size=2048",
                "-s", "fastmem_size=8192",

                "-s","filesystem2=rw,DH0:${workspaceFolder}\\uae\\dh0,0",

                "-s", "joyport1=kbd2",
            ],
            "preLaunchTask": "amigaassembly: build"
        }
    ]
}
