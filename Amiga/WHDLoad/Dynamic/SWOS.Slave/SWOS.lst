                            	   111: 
                            	   112: 
                            	   113: ******* Other Globals ******************************************************
                            	   114: 
                            	   115: 	STRUCT	LastAlert,4*4
                            	     1M LastAlert	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4*4
                            	   116: 
                            	   117: 	;------ these next two variables are provided to allow
                            	   118: 	;------ system developers to have a rough idea of the
                            	   119: 	;------ period of two externally controlled signals --
                            	   120: 	;------ the time between vertical blank interrupts and the
                            	   121: 	;------ external line rate (which is counted by CIA A's
                            	   122: 	;------ "time of day" clock).  In general these values
                            	   123: 	;------ will be 50 or 60, and may or may not track each
                            	   124: 	;------ other.  These values replace the obsolete AFB_PAL
                            	   125: 	;------ and AFB_50HZ flags.
                            	   126: 	UBYTE	VBlankFrequency 	;(readable)
                            	     1M VBlankFrequency	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	   127: 	UBYTE	PowerSupplyFrequency	;(readable)
                            	     1M PowerSupplyFrequency	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	   128: 
                            	   129: 	STRUCT	SemaphoreList,LH_SIZE
                            	     1M SemaphoreList	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+LH_SIZE
                            	   130: 
                            	   131: 	;------ these next two are to be able to kickstart into user ram.
                            	   132: 	;------ KickMemPtr holds a singly linked list of MemLists which
                            	   133: 	;------ will be removed from the memory list via AllocAbs.	If
                            	   134: 	;------ all the AllocAbs's succeeded, then the KickTagPtr will
                            	   135: 	;------ be added to the rom tag list.
                            	   136: 	APTR	KickMemPtr	; ptr to queue of mem lists
                            	     1M KickMemPtr	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   137: 	APTR	KickTagPtr	; ptr to rom tag queue
                            	     1M KickTagPtr	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   138: 	APTR	KickCheckSum	; checksum for mem and tags
                            	     1M KickCheckSum	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   139: 
                            	   140: 
                            	   141: ******* V36 Exec additions start here ***************************************
                            	   142: 
                            	   143: 	UWORD	ex_Pad0		; Private internal use
                            	     1M ex_Pad0	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	   144: 	ULONG	ex_LaunchPoint	; Private to Launch/Switch
                            	     1M ex_LaunchPoint	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   145: 	APTR	ex_RamLibPrivate
                            	     1M ex_RamLibPrivate	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   146: 	;* The next ULONG contains the system "E" clock frequency,
                            	   147: 	;* expressed in Hertz.  The E clock is used as a timebase for
                            	   148: 	;* the Amiga's 8520 I/O chips. (E is connected to "02").
                            	   149: 	;* Typical values are 715909 for NTSC, or 709379 for PAL.
                            	   150: 	;*
                            	   151: 	ULONG	ex_EClockFrequency ;(readable)
                            	     1M ex_EClockFrequency	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   152: 	ULONG	ex_CacheControl	   ;Private to the CacheControl call
                            	     1M ex_CacheControl	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   153: 	ULONG	ex_TaskID	   ;Next available task ID
                            	     1M ex_TaskID	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   154: 
                            	   155: 	STRUCT	ex_Reserved1,5*4
                            	     1M ex_Reserved1	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+5*4
                            	   156: 
                            	   157: 	APTR	ex_MMULock	   ;Private
                            	     1M ex_MMULock	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   158: 
                            	   159: 	STRUCT	ex_Reserved2,3*4
                            	     1M ex_Reserved2	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+3*4
                            	   160: 
                            	   161: ******* V39 Exec additions start here ***************************************
                            	   162: 
                            	   163: 	;* The following list and data element are used for
                            	   164: 	;* V39 exec's low memory handler.
                            	   165:         STRUCT	ex_MemHandlers,MLH_SIZE		;* List of handlers
                            	     1M ex_MemHandlers	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+MLH_SIZE
                            	   166: 	APTR	ex_MemHandler			;* Handler pointer (PRIVATE!)
                            	     1M ex_MemHandler	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   167: 
                            	   168: 	LABEL	SYSBASESIZE
                            	     1M SYSBASESIZE	    EQU     SOFFSET
                            	   169: 
                            	   170: 
                            	   171: ******* Bit defines for AttnFlags (see above) *******************************
                            	   172: 
                            	   173: *  Processors and Co-processors:
                            	   174: 	BITDEF	AF,68010,0	; also set for 68020
                            	     1M 	    BITDEF0 AF,68010,B_,0
                            	     1M AFB_68010	    EQU     0
                            	     2M _000162BITDEF    SET     1<<0
                            	     3M 	    BITDEF0 AF,68010,F_,_000162BITDEF
                            	     1M AFF_68010	    EQU     _000162BITDEF
                            	   175: 	BITDEF	AF,68020,1	; also set for 68030
                            	     1M 	    BITDEF0 AF,68020,B_,1
                            	     1M AFB_68020	    EQU     1
                            	     2M _000165BITDEF    SET     1<<1
                            	     3M 	    BITDEF0 AF,68020,F_,_000165BITDEF
                            	     1M AFF_68020	    EQU     _000165BITDEF
                            	   176: 	BITDEF	AF,68030,2	; also set for 68040
                            	     1M 	    BITDEF0 AF,68030,B_,2
                            	     1M AFB_68030	    EQU     2
                            	     2M _000168BITDEF    SET     1<<2
                            	     3M 	    BITDEF0 AF,68030,F_,_000168BITDEF
                            	     1M AFF_68030	    EQU     _000168BITDEF
                            	   177: 	BITDEF	AF,68040,3	; also set for 68060
                            	     1M 	    BITDEF0 AF,68040,B_,3
                            	     1M AFB_68040	    EQU     3
                            	     2M _000171BITDEF    SET     1<<3
                            	     3M 	    BITDEF0 AF,68040,F_,_000171BITDEF
                            	     1M AFF_68040	    EQU     _000171BITDEF
                            	   178: 	BITDEF	AF,68881,4	; also set for 68882
                            	     1M 	    BITDEF0 AF,68881,B_,4
                            	     1M AFB_68881	    EQU     4
                            	     2M _000174BITDEF    SET     1<<4
                            	     3M 	    BITDEF0 AF,68881,F_,_000174BITDEF
                            	     1M AFF_68881	    EQU     _000174BITDEF
                            	   179: 	BITDEF	AF,68882,5
                            	     1M 	    BITDEF0 AF,68882,B_,5
                            	     1M AFB_68882	    EQU     5
                            	     2M _000177BITDEF    SET     1<<5
                            	     3M 	    BITDEF0 AF,68882,F_,_000177BITDEF
                            	     1M AFF_68882	    EQU     _000177BITDEF
                            	   180: 	BITDEF	AF,FPU40,6	; Set if 68040 FPU
                            	     1M 	    BITDEF0 AF,FPU40,B_,6
                            	     1M AFB_FPU40	    EQU     6
                            	     2M _000180BITDEF    SET     1<<6
                            	     3M 	    BITDEF0 AF,FPU40,F_,_000180BITDEF
                            	     1M AFF_FPU40	    EQU     _000180BITDEF
                            	   181: 	BITDEF	AF,68060,7	; set for 68060 CPU
                            	     1M 	    BITDEF0 AF,68060,B_,7
                            	     1M AFB_68060	    EQU     7
                            	     2M _000183BITDEF    SET     1<<7
                            	     3M 	    BITDEF0 AF,68060,F_,_000183BITDEF
                            	     1M AFF_68060	    EQU     _000183BITDEF
                            	   182: 	BITDEF	AF,FPGA,10	; set for FPGA implementations of the CPU
                            	     1M 	    BITDEF0 AF,FPGA,B_,10
                            	     1M AFB_FPGA	    EQU     10
                            	     2M _000186BITDEF    SET     1<<10
                            	     3M 	    BITDEF0 AF,FPGA,F_,_000186BITDEF
                            	     1M AFF_FPGA	    EQU     _000186BITDEF
                            	   183: ;
                            	   184: ; The AFB_FPU40 bit is set when a working 68040 FPU
                            	   185: ; is in the system.  If this bit is set and both the
                            	   186: ; AFB_68881 and AFB_68882 bits are not set, then the 68040
                            	   187: ; math emulation code has not been loaded and only 68040
                            	   188: ; FPU instructions are available.  This bit is valid *ONLY*
                            	   189: ; if the AFB_68040 bit is set.
                            	   190: ;
                            	   191: ;	BITDEF	AF,RESERVED8,8
                            	   192: ;	BITDEF	AF,RESERVED9,9
                            	   193: 	BITDEF	AF,PRIVATE,15	; Just what it says
                            	     1M 	    BITDEF0 AF,PRIVATE,B_,15
                            	     1M AFB_PRIVATE	    EQU     15
                            	     2M _000189BITDEF    SET     1<<15
                            	     3M 	    BITDEF0 AF,PRIVATE,F_,_000189BITDEF
                            	     1M AFF_PRIVATE	    EQU     _000189BITDEF
                            	   194: 
                            	   195: 
                            	   196: ******* Selected bit definitions for Cache manipulation calls **************
                            	   197: 
                            	   198: 	BITDEF	CACR,EnableI,0		;Enable instruction cache
                            	     1M 	    BITDEF0 CACR,EnableI,B_,0
                            	     1M CACRB_EnableI	    EQU     0
                            	     2M _000192BITDEF    SET     1<<0
                            	     3M 	    BITDEF0 CACR,EnableI,F_,_000192BITDEF
                            	     1M CACRF_EnableI	    EQU     _000192BITDEF
                            	   199: 	BITDEF	CACR,FreezeI,1		;Freeze instruction cache
                            	     1M 	    BITDEF0 CACR,FreezeI,B_,1
                            	     1M CACRB_FreezeI	    EQU     1
                            	     2M _000195BITDEF    SET     1<<1
                            	     3M 	    BITDEF0 CACR,FreezeI,F_,_000195BITDEF
                            	     1M CACRF_FreezeI	    EQU     _000195BITDEF
                            	   200: 	BITDEF	CACR,ClearI,3		;Clear instruction cache
                            	     1M 	    BITDEF0 CACR,ClearI,B_,3
                            	     1M CACRB_ClearI	    EQU     3
                            	     2M _000198BITDEF    SET     1<<3
                            	     3M 	    BITDEF0 CACR,ClearI,F_,_000198BITDEF
                            	     1M CACRF_ClearI	    EQU     _000198BITDEF
                            	   201: 	BITDEF	CACR,IBE,4		;Instruction burst enable
                            	     1M 	    BITDEF0 CACR,IBE,B_,4
                            	     1M CACRB_IBE	    EQU     4
                            	     2M _000201BITDEF    SET     1<<4
                            	     3M 	    BITDEF0 CACR,IBE,F_,_000201BITDEF
                            	     1M CACRF_IBE	    EQU     _000201BITDEF
                            	   202: 	BITDEF	CACR,EnableD,8		;68030 Enable data cache
                            	     1M 	    BITDEF0 CACR,EnableD,B_,8
                            	     1M CACRB_EnableD	    EQU     8
                            	     2M _000204BITDEF    SET     1<<8
                            	     3M 	    BITDEF0 CACR,EnableD,F_,_000204BITDEF
                            	     1M CACRF_EnableD	    EQU     _000204BITDEF
                            	   203: 	BITDEF	CACR,FreezeD,9		;68030 Freeze data cache
                            	     1M 	    BITDEF0 CACR,FreezeD,B_,9
                            	     1M CACRB_FreezeD	    EQU     9
                            	     2M _000207BITDEF    SET     1<<9
                            	     3M 	    BITDEF0 CACR,FreezeD,F_,_000207BITDEF
                            	     1M CACRF_FreezeD	    EQU     _000207BITDEF
                            	   204: 	BITDEF	CACR,ClearD,11		;68030 Clear data cache
                            	     1M 	    BITDEF0 CACR,ClearD,B_,11
                            	     1M CACRB_ClearD	    EQU     11
                            	     2M _000210BITDEF    SET     1<<11
                            	     3M 	    BITDEF0 CACR,ClearD,F_,_000210BITDEF
                            	     1M CACRF_ClearD	    EQU     _000210BITDEF
                            	   205: 	BITDEF	CACR,DBE,12		;68030 Data burst enable
                            	     1M 	    BITDEF0 CACR,DBE,B_,12
                            	     1M CACRB_DBE	    EQU     12
                            	     2M _000213BITDEF    SET     1<<12
                            	     3M 	    BITDEF0 CACR,DBE,F_,_000213BITDEF
                            	     1M CACRF_DBE	    EQU     _000213BITDEF
                            	   206: 	BITDEF	CACR,WriteAllocate,13	;68030 Write-Allocate mode (must
                            	     1M 	    BITDEF0 CACR,WriteAllocate,B_,13
                            	     1M CACRB_WriteAllocate	    EQU     13
                            	     2M _000216BITDEF    SET     1<<13
                            	     3M 	    BITDEF0 CACR,WriteAllocate,F_,_000216BITDEF
                            	     1M CACRF_WriteAllocate	    EQU     _000216BITDEF
                            	   207: 					;always be set)
                            	   208: 	BITDEF  CACR,EnableE,30		;Master enable for external caches
                            	     1M 	    BITDEF0 CACR,EnableE,B_,30
                            	     1M CACRB_EnableE	    EQU     30
                            	     2M _000219BITDEF    SET     1<<30
                            	     3M 	    BITDEF0 CACR,EnableE,F_,_000219BITDEF
                            	     1M CACRF_EnableE	    EQU     _000219BITDEF
                            	   209: 					;External caches should track the
                            	   210: 					;state of the internal caches
                            	   211: 					;such that they do not cache anything
                            	   212: 					;that the internal cache turned off
                            	   213: 					;for.
                            	   214: 	BITDEF	CACR,CopyBack,31	;Master enable for copyback caches
                            	     1M 	    BITDEF0 CACR,CopyBack,B_,31
                            	     1M CACRB_CopyBack	    EQU     31
                            	     2M _000222BITDEF    SET     1<<31
                            	     3M 	    BITDEF0 CACR,CopyBack,F_,_000222BITDEF
                            	     1M CACRF_CopyBack	    EQU     _000222BITDEF
                            	   215: 
                            	   216: 
                            	   217: 	BITDEF	DMA,Continue,1		;Continuation flag for CachePreDMA
                            	     1M 	    BITDEF0 DMA,Continue,B_,1
                            	     1M DMAB_Continue	    EQU     1
                            	     2M _000225BITDEF    SET     1<<1
                            	     3M 	    BITDEF0 DMA,Continue,F_,_000225BITDEF
                            	     1M DMAF_Continue	    EQU     _000225BITDEF
                            	   218: 	BITDEF	DMA,NoModify,2		;Set if DMA does not update memory
                            	     1M 	    BITDEF0 DMA,NoModify,B_,2
                            	     1M DMAB_NoModify	    EQU     2
                            	     2M _000228BITDEF    SET     1<<2
                            	     3M 	    BITDEF0 DMA,NoModify,F_,_000228BITDEF
                            	     1M DMAF_NoModify	    EQU     _000228BITDEF
                            	   219: 	BITDEF	DMA,ReadFromRAM,3	;Set if DMA goes *FROM* RAM to device
                            	     1M 	    BITDEF0 DMA,ReadFromRAM,B_,3
                            	     1M DMAB_ReadFromRAM	    EQU     3
                            	     2M _000231BITDEF    SET     1<<3
                            	     3M 	    BITDEF0 DMA,ReadFromRAM,F_,_000231BITDEF
                            	     1M DMAF_ReadFromRAM	    EQU     _000231BITDEF
