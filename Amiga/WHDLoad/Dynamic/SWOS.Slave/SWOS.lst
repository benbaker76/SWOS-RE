                            	    72: DIPF_IS_ECS			equ	$00000010  ; note: ECS modes (SHIRES, VGA, and
                            	    73: 						   ; PRODUCTIVITY) do not support
                            	    74: 						   ; attached sprites.
                            	    75: 
                            	    76: DIPF_IS_AA			equ	$00010000
                            	    77: DIPF_IS_PAL			equ	$00000020
                            	    78: DIPF_IS_SPRITES			equ	$00000040
                            	    79: DIPF_IS_GENLOCK			equ	$00000080
