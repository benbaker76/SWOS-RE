                            	    73: ;=============================================================================
                            	    74: ;	return-values for termination (resload_Abort)
                            	    75: ;=============================================================================
                            	    76: 
                            	    77: TDREASON_OK		= -1	;normal termination
                            	    78: TDREASON_DOSREAD	= 1	;error caused by resload_ReadFile
                            	    79: 				; primary   = dos errorcode
                            	    80: 				; secondary = file name
                            	    81: TDREASON_DOSWRITE	= 2	;error caused by resload_SaveFile or
                            	    82: 				;resload_SaveFileOffset
                            	    83: 				; primary   = dos errorcode
                            	    84: 				; secondary = file name
                            	    85: TDREASON_DEBUG		= 5	;cause WHDLoad to make a coredump and quit
                            	    86: 				; primary   = PC (to be written to dump files)
                            	    87: 				; secondary = SR (to be written to dump files)
                            	    88: TDREASON_DOSLIST	= 6	;error caused by resload_ListFiles
                            	    89: 				; primary   = dos errorcode
                            	    90: 				; secondary = directory name
                            	    91: TDREASON_DISKLOAD	= 7	;error caused by resload_DiskLoad
                            	    92: 				; primary   = dos errorcode
                            	    93: 				; secondary = disk number
                            	    94: TDREASON_DISKLOADDEV	= 8	;error caused by resload_DiskLoadDev
                            	    95: 				; primary   = trackdisk errorcode
                            	    96: TDREASON_WRONGVER	= 9	;an version check (e.g. CRC16) has detected an
                            	    97: 				;unsupported version of the installed program
                            	    98: TDREASON_OSEMUFAIL	= 10	;error in the OS emulation module
                            	    99: 				; primary   = subsystem (e.g. "exec.library")
                            	   100: 				; secondary = error number (e.g. _LVOAllocMem)
                            	   101: ; version 7
                            	   102: TDREASON_REQ68020	= 11	;installed program requires a MC68020
                            	   103: TDREASON_REQAGA		= 12	;installed program requires the AGA chip set
                            	   104: TDREASON_MUSTNTSC	= 13	;installed program needs NTSC video mode to run
                            	   105: TDREASON_MUSTPAL	= 14	;installed program needs PAL video mode to run
                            	   106: ; version 8
                            	   107: TDREASON_MUSTREG	= 15	;WHDLoad must be registered
                            	   108: TDREASON_DELETEFILE	= 27	;error caused by resload_DeleteFile
                            	   109: 				; primary   = dos errorcode
                            	   110: 				; secondary = file name
                            	   111: ; version 14.1
                            	   112: TDREASON_FAILMSG	= 43	;fail with a slave defined message text
                            	   113: 				; primary   = text
                            	   114: 
