Source: "exec\lists.i"
                            	     1: 	IFND	EXEC_LISTS_I
                            	     2: EXEC_LISTS_I	SET	1
                            	     3: **
                            	     4: **	$VER: lists.i 47.1 (28.6.2019)
                            	     5: **
                            	     6: **	Definitions and macros for use with Exec lists
                            	     7: **
                            	     8: **	Copyright (C) 2019 Hyperion Entertainment CVBA.
                            	     9: **	    Developed under license.
                            	    10: **
                            	    11: 
                            	    12: 	IFND EXEC_NODES_I
                            	    13: 	INCLUDE "exec/nodes.i"

Source: "exec\nodes.i"
                            	     1: 	IFND EXEC_NODES_I
                            	     2: EXEC_NODES_I	SET 1
                            	     3: **
                            	     4: **	$VER: nodes.i 47.1 (28.6.2019)
                            	     5: **
                            	     6: **	Nodes & Node type identifiers.
                            	     7: **
                            	     8: **	Copyright (C) 2019 Hyperion Entertainment CVBA.
                            	     9: **	    Developed under license.
                            	    10: **
                            	    11: 
                            	    12:     IFND EXEC_TYPES_I
                            	    13:     INCLUDE "exec/types.i"
                            	    14:     ENDC ; EXEC_TYPES_I
                            	    15: 
                            	    16: 
                            	    17: *
                            	    18: *   List Node Structure.  Each member in a list starts with a Node
                            	    19: *
                            	    20:    STRUCTURE	LN,0	; List Node
                            	     1M LN	    EQU     0
                            	     2M SOFFSET     SET     0
                            	    21: 	APTR	LN_SUCC	; Pointer to next (successor)
                            	     1M LN_SUCC	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    22: 	APTR	LN_PRED	; Pointer to previous (predecessor)
                            	     1M LN_PRED	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    23: 	UBYTE	LN_TYPE
                            	     1M LN_TYPE	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	    24: 	BYTE	LN_PRI	; Priority, for sorting
                            	     1M LN_PRI	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	    25: 	APTR	LN_NAME	; ID string, null terminated
                            	     1M LN_NAME	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    26: 	LABEL	LN_SIZE	; Note: word aligned
                            	     1M LN_SIZE	    EQU     SOFFSET
                            	    27: 
                            	    28: ; minimal node -- no type checking possible
                            	    29:    STRUCTURE	MLN,0	; Minimal List Node
                            	     1M MLN	    EQU     0
                            	     2M SOFFSET     SET     0
                            	    30: 	APTR	MLN_SUCC
                            	     1M MLN_SUCC	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    31: 	APTR	MLN_PRED
                            	     1M MLN_PRED	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    32: 	LABEL	MLN_SIZE
                            	     1M MLN_SIZE	    EQU     SOFFSET
                            	    33: 
                            	    34: 
                            	    35: **
                            	    36: ** Note: Newly initialized IORequests, and software interrupt structures
                            	    37: ** used with Cause(), should have type NT_UNKNOWN.  The OS will assign a type
                            	    38: ** when they are first used.
                            	    39: **
                            	    40: ;------ Node Types for LN_TYPE
                            	    41: 
                            	    42: NT_UNKNOWN	EQU 0
                            	    43: NT_TASK	EQU 1	; Exec task
                            	    44: NT_INTERRUPT	EQU 2
                            	    45: NT_DEVICE	EQU 3
                            	    46: NT_MSGPORT	EQU 4
                            	    47: NT_MESSAGE	EQU 5	; Indicates message currently pending
                            	    48: NT_FREEMSG	EQU 6
                            	    49: NT_REPLYMSG	EQU 7	; Message has been replied
                            	    50: NT_RESOURCE	EQU 8
                            	    51: NT_LIBRARY	EQU 9
                            	    52: NT_MEMORY	EQU 10
                            	    53: NT_SOFTINT	EQU 11	; Internal flag used by SoftInts
                            	    54: NT_FONT	EQU 12
                            	    55: NT_PROCESS	EQU 13	; AmigaDOS Process
                            	    56: NT_SEMAPHORE	EQU 14
                            	    57: NT_SIGNALSEM	EQU 15	; signal semaphores
                            	    58: NT_BOOTNODE	EQU 16
                            	    59: NT_KICKMEM	EQU 17
                            	    60: NT_GRAPHICS	EQU 18
                            	    61: NT_DEATHMESSAGE	EQU 19
                            	    62: 
                            	    63: NT_USER		EQU 254	; User node types work down from here
                            	    64: NT_EXTENDED	EQU 255
                            	    65: 
                            	    66: 	ENDC	;EXEC_NODES_I
                            	    67: 

Source: "exec\lists.i"
                            	    14: 	ENDC	; EXEC_NODES_I
                            	    15: 
                            	    16: 
                            	    17: *---------------------------------------------------------------------
                            	    18: 
                            	    19: *
                            	    20: * Full featured list header
                            	    21: *
                            	    22:    STRUCTURE	LH,0
                            	     1M LH	    EQU     0
                            	     2M SOFFSET     SET     0
                            	    23: 	APTR	LH_HEAD
                            	     1M LH_HEAD	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    24: 	APTR	LH_TAIL
                            	     1M LH_TAIL	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    25: 	APTR	LH_TAILPRED
                            	     1M LH_TAILPRED	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    26: 	UBYTE	LH_TYPE
                            	     1M LH_TYPE	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	    27: 	UBYTE	LH_pad
                            	     1M LH_pad	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	    28: 	LABEL	LH_SIZE ;word aligned
                            	     1M LH_SIZE	    EQU     SOFFSET
                            	    29: 
                            	    30: *
                            	    31: * Minimal List Header - no type checking (best for most applications)
                            	    32: *
                            	    33:    STRUCTURE	MLH,0
                            	     1M MLH	    EQU     0
                            	     2M SOFFSET     SET     0
                            	    34: 	APTR	MLH_HEAD
                            	     1M MLH_HEAD	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    35: 	APTR	MLH_TAIL
                            	     1M MLH_TAIL	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    36: 	APTR	MLH_TAILPRED
                            	     1M MLH_TAILPRED	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    37: 	LABEL	MLH_SIZE ;longword aligned
                            	     1M MLH_SIZE	    EQU     SOFFSET
                            	    38: 
                            	    39: *---------------------------------------------------------------------
                            	    40: 
                            	    41: ;Prepare a list header for use
                            	    42: NEWLIST     MACRO   ; list
                            	    43: 	    MOVE.L  \1,LH_TAILPRED(\1)
                            	    44: 	    ADDQ.L  #4,\1	;Get address of LH_TAIL
                            	    45: 	    CLR.L   (\1)	;Clear LH_TAIL
                            	    46: 	    MOVE.L  \1,-(\1)    ;Address of LH_TAIL to LH_HEAD
                            	    47: 	    ENDM
                            	    48: 
                            	    49: ;Test if list is empty (list address in register)
                            	    50: ;This operation is safe at any time - no list arbitration needed.
                            	    51: TSTLIST     MACRO   ; [list]
                            	    52: 	    IFGT    NARG-1
                            	    53: 	       FAIL    !!! TSTLIST - Too many arguments !!!
                            	    54: 	    ENDC
                            	    55: 	    IFC     '\1',''
                            	    56: 	    CMP.L   LH_TAIL+LN_PRED(A0),A0
                            	    57: 	    ENDC
                            	    58: 	    IFNC    '\1',''
                            	    59: 	    CMP.L   LH_TAIL+LN_PRED(\1),\1
                            	    60: 	    ENDC
                            	    61: 	    ENDM
                            	    62: 
                            	    63: ;Test if list is empty (from effective address of list)
                            	    64: ;list arbitration required.
                            	    65: TSTLST2     MACRO    ;EA of list,=node
                            	    66: 	    MOVE.L   \1,\2
                            	    67: 	    TST.L    (\2)
                            	    68: 	    ENDM
                            	    69: 
                            	    70: ;Get next in list
                            	    71: SUCC	    MACRO   ; node,=succ
                            	    72: 	    MOVE.L  (\1),\2
                            	    73: 	    ENDM
                            	    74: 
                            	    75: ;Get previous in list
                            	    76: PRED	    MACRO   ; node,=pred
                            	    77: 	    MOVE.L  LN_PRED(\1),\2
                            	    78: 	    ENDM
                            	    79: 
                            	    80: ;If empty, branch
                            	    81: IFEMPTY     MACRO   ; list,label
                            	    82: 	    CMP.L   LH_TAIL+LN_PRED(\1),\1
                            	    83: 	    BEQ     \2
                            	    84: 	    ENDM
                            	    85: 
                            	    86: ;If not empty, branch
                            	    87: IFNOTEMPTY  MACRO   ; list,label
                            	    88: 	    CMP.L   LH_TAIL+LN_PRED(\1),\1
                            	    89: 	    BNE     \2
                            	    90: 	    ENDM
                            	    91: 
                            	    92: ;Get next node, test if at end
                            	    93: TSTNODE     MACRO   ; node,=next
                            	    94: 	    MOVE.L  (\1),\2
                            	    95: 	    TST.L   (\2)
                            	    96: 	    ENDM
                            	    97: 
                            	    98: ;Get next, go to exit label if at end
                            	    99: NEXTNODE    MACRO   ; next=next,=current,exit_label ([.s],DX,AX,DISP16)
                            	   100: 	    MOVE.L  \1,\2
                            	   101: 	    MOVE.L  (\2),\1
                            	   102: 	    IFC     '\0',''     ;Check extension
                            	   103: 	    BEQ     \3
                            	   104: 	    ENDC
                            	   105: 	    IFNC    '\0',''
                            	   106: 	    BEQ.S   \3
                            	   107: 	    ENDC
                            	   108: 	    ENDM
                            	   109: 
                            	   110: ;Add to head of list
                            	   111: ADDHEAD     MACRO   ; A0-list(destroyed) A1-node D0-(destroyed)
                            	   112: 	    MOVE.L  (A0),D0
                            	   113: 	    MOVE.L  A1,(A0)
                            	   114: 	    MOVEM.L D0/A0,(A1)
                            	   115: 	    MOVE.L  D0,A0
                            	   116: 	    MOVE.L  A1,LN_PRED(A0)
                            	   117: 	    ENDM
                            	   118: 
                            	   119: ;Add to tail of list
                            	   120: ADDTAIL     MACRO   ; A0-list(destroyed) A1-node D0-(destroyed)
                            	   121: 	    ADDQ.L  #LH_TAIL,A0
                            	   122: 	    MOVE.L  LN_PRED(A0),D0
                            	   123: 	    MOVE.L  A1,LN_PRED(A0)
                            	   124: 	    EXG     D0,A0
                            	   125: 	    MOVEM.L D0/A0,(A1)
                            	   126: 	    MOVE.L  A1,(A0)
                            	   127: 	    ENDM
                            	   128: 
                            	   129: ;Remove node from whatever list it is in
                            	   130: REMOVE	    MACRO   ; A0-(destroyed)  A1-node(destroyed)
                            	   131: 	    MOVE.L  (A1)+,A0
                            	   132: 	    MOVE.L  (A1),A1	; LN_PRED
                            	   133: 	    MOVE.L  A0,(A1)
                            	   134: 	    MOVE.L  A1,LN_PRED(A0)
                            	   135: 	    ENDM
                            	   136: 
                            	   137: ;Remove node from head of list
                            	   138: REMHEAD     MACRO   ; A0-list A1-(destroyed) D0=node
                            	   139: 	    MOVE.L  (A0),A1
                            	   140: 	    MOVE.L  (A1),D0
                            	   141: 	    BEQ.S   REMHEAD\@
                            	   142: 	    MOVE.L  D0,(A0)
                            	   143: 	    EXG.L   D0,A1
                            	   144: 	    MOVE.L  A0,LN_PRED(A1)
                            	   145: REMHEAD\@
                            	   146: 	    ENDM
                            	   147: 
                            	   148: ;Remove head quickly
                            	   149: ;	Useful when a scratch register is available, and
                            	   150: ;	list is known to contain at least one node.
                            	   151: REMHEADQ    MACRO   ; list,=node,scratchReg-(destroyed)
                            	   152: 	    MOVE.L  (\1),\2
                            	   153: 	    MOVE.L  (\2),\3
                            	   154: 	    MOVE.L  \3,(\1)
                            	   155: 	    MOVE.L  \1,LN_PRED(\3)
                            	   156: 	    ENDM
                            	   157: 
                            	   158: ;Remove node from tail of list
                            	   159: REMTAIL     MACRO   ; A0-list A1-(destroyed) D0=node
                            	   160: 	    MOVE.L  LH_TAIL+LN_PRED(A0),A1
                            	   161: 	    MOVE.L  LN_PRED(A1),D0
                            	   162: 	    BEQ.S   REMTAIL\@
                            	   163: 	    MOVE.L  D0,LH_TAIL+LN_PRED(A0)
                            	   164: 	    EXG.L   D0,A1
                            	   165: 	    MOVE.L  A0,(A1)
                            	   166: 	    ADDQ.L  #4,(A1)
                            	   167: REMTAIL\@
                            	   168: 	    ENDM
                            	   169: 
                            	   170: 	ENDC	; EXEC_LISTS_I
                            	   171: 

Source: "exec\execbase.i"
                            	    18:     ENDC	; EXEC_LISTS_I
                            	    19: 
                            	    20:     IFND EXEC_INTERRUPTS_I
                            	    21:     INCLUDE "exec/interrupts.i"

Source: "exec\interrupts.i"
                            	     1: 	IFND	EXEC_INTERRUPTS_I
                            	     2: EXEC_INTERRUPTS_I	SET	1
                            	     3: **
                            	     4: **	$VER: interrupts.i 47.1 (28.6.2019)
                            	     5: **
                            	     6: **	Callback structures used by hardware & software interrupts
                            	     7: **
                            	     8: **	Copyright (C) 2019 Hyperion Entertainment CVBA.
                            	     9: **	    Developed under license.
                            	    10: **
                            	    11: 
                            	    12:     IFND EXEC_NODES_I
                            	    13:     INCLUDE "exec/nodes.i"
                            	    14:     ENDC	; EXEC_NODES_I
                            	    15: 
                            	    16:     IFND EXEC_LISTS_I
                            	    17:     INCLUDE "exec/lists.i"
                            	    18:     ENDC	; EXEC_LISTS_I
                            	    19: 
                            	    20: 
                            	    21: *----------------------------------------------------------------
                            	    22: *
                            	    23: *   Interrupt Structure
                            	    24: *
                            	    25: *----------------------------------------------------------------
                            	    26:         
                            	    27:  STRUCTURE  IS,LN_SIZE
                            	     1M IS	    EQU     0
                            	     2M SOFFSET     SET     LN_SIZE
                            	    28:     APTR    IS_DATA
                            	     1M IS_DATA	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    29:     APTR    IS_CODE
                            	     1M IS_CODE	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    30:     LABEL   IS_SIZE
                            	     1M IS_SIZE	    EQU     SOFFSET
                            	    31: 
                            	    32: 
                            	    33: *---------------------------------------------------------------------
                            	    34: *
                            	    35: *   Exec Internal Interrupt Vectors
                            	    36: *
                            	    37: *---------------------------------------------------------------------
                            	    38: 
                            	    39:  STRUCTURE  IV,0
                            	     1M IV	    EQU     0
                            	     2M SOFFSET     SET     0
                            	    40:     APTR    IV_DATA
                            	     1M IV_DATA	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    41:     APTR    IV_CODE
                            	     1M IV_CODE	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    42:     APTR    IV_NODE
                            	     1M IV_NODE	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    43:     LABEL   IV_SIZE
                            	     1M IV_SIZE	    EQU     SOFFSET
                            	    44: 
                            	    45: 
                            	    46: *------ System Flag bits (in SysBase.SysFlags )
                            	    47: 
                            	    48:     BITDEF  S,SAR,15        ; scheduling attention required (TOP BIT)
                            	     1M 	    BITDEF0 S,SAR,B_,15
                            	     1M SB_SAR	    EQU     15
                            	     2M _000039BITDEF    SET     1<<15
                            	     3M 	    BITDEF0 S,SAR,F_,_000039BITDEF
                            	     1M SF_SAR	    EQU     _000039BITDEF
                            	    49:     BITDEF  S,TQE,14        ; time quantum expended -- time to resched
                            	     1M 	    BITDEF0 S,TQE,B_,14
                            	     1M SB_TQE	    EQU     14
                            	     2M _000042BITDEF    SET     1<<14
                            	     3M 	    BITDEF0 S,TQE,F_,_000042BITDEF
                            	     1M SF_TQE	    EQU     _000042BITDEF
                            	    50:     BITDEF  S,SINT,13
                            	     1M 	    BITDEF0 S,SINT,B_,13
                            	     1M SB_SINT	    EQU     13
                            	     2M _000045BITDEF    SET     1<<13
                            	     3M 	    BITDEF0 S,SINT,F_,_000045BITDEF
                            	     1M SF_SINT	    EQU     _000045BITDEF
                            	    51: 
                            	    52: 
                            	    53: *---------------------------------------------------------------------
                            	    54: *
                            	    55: *   Software Interrupt List Headers
                            	    56: *
                            	    57: *---------------------------------------------------------------------
                            	    58: 
                            	    59:  STRUCTURE  SH,LH_SIZE
                            	     1M SH	    EQU     0
                            	     2M SOFFSET     SET     LH_SIZE
                            	    60:     UWORD   SH_PAD
                            	     1M SH_PAD	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    61:     LABEL   SH_SIZE
                            	     1M SH_SIZE	    EQU     SOFFSET
                            	    62: 
                            	    63: SIH_PRIMASK  EQU        $0F0
                            	    64: SIH_QUEUES   EQU        5
                            	    65: 
                            	    66: ** this is a fake INT definition, used only for AddIntServer and the like
                            	    67:         BITDEF  INT,NMI,15
                            	     1M 	    BITDEF0 INT,NMI,B_,15
                            	     1M INTB_NMI	    EQU     15
                            	     2M _000051BITDEF    SET     1<<15
                            	     3M 	    BITDEF0 INT,NMI,F_,_000051BITDEF
                            	     1M INTF_NMI	    EQU     _000051BITDEF
                            	    68: 
                            	    69: 	ENDC	; EXEC_INTERRUPTS_I
                            	    70: 

Source: "exec\execbase.i"
                            	    22:     ENDC	; EXEC_INTERRUPTS_I
                            	    23: 
                            	    24:     IFND EXEC_LIBRARIES_I
                            	    25:     INCLUDE "exec/libraries.i"

Source: "exec\libraries.i"
                            	     1: 	IFND	EXEC_LIBRARIES_I
                            	     2: EXEC_LIBRARIES_I	SET	1
                            	     3: **
                            	     4: **	$VER: libraries.i 47.2 (19.1.2021)
                            	     5: **
                            	     6: **	Definitions for use when creating or using Exec libraries
                            	     7: **
                            	     8: **	Copyright (C) 2019-2022 Hyperion Entertainment CVBA.
                            	     9: **	    Developed under license.
                            	    10: **
                            	    11: 
                            	    12:     IFND EXEC_NODES_I
                            	    13:     INCLUDE "exec/nodes.i"
                            	    14:     ENDC	; EXEC_NODES_I
                            	    15: 
                            	    16: 
                            	    17: *------ Special Constants ---------------------------------------
                            	    18: LIB_VECTSIZE    EQU     6		;Each library entry takes 6 bytes
                            	    19: LIB_RESERVED    EQU     4		;Exec reserves the first 4 vectors
                            	    20: LIB_BASE        EQU	-LIB_VECTSIZE
                            	    21: LIB_USERDEF     EQU     LIB_BASE-(LIB_RESERVED*LIB_VECTSIZE) ;First user func
                            	    22: LIB_NONSTD      EQU     LIB_USERDEF
                            	    23: 
                            	    24: 
                            	    25: *----------------------------------------------------------------
                            	    26: *
                            	    27: *   Library Definition Macros (for creating libraries)
                            	    28: *
                            	    29: *----------------------------------------------------------------
                            	    30: 
                            	    31: *------ LIBINIT initializes the base offset for using the "LIBDEF" macro:
                            	    32: LIBINIT     MACRO   ; [baseOffset]
                            	    33:             IFC     '\1',''
                            	    34: COUNT_LIB   SET     LIB_USERDEF
                            	    35:             ENDC
                            	    36:             IFNC    '\1',''
                            	    37: COUNT_LIB   SET     \1
                            	    38:             ENDC
                            	    39:             ENDM
                            	    40: 
                            	    41: *------ LIBDEF is used to define each library function entry:
                            	    42: LIBDEF      MACRO   ;libraryFunctionSymbol
                            	    43: \1          EQU     COUNT_LIB
                            	    44: COUNT_LIB   SET     COUNT_LIB-LIB_VECTSIZE
                            	    45:             ENDM
                            	    46: 
                            	    47: *------ FUNCDEF is used to parse library offset tables.  Many applications
                            	    48: *------ need a special version of FUNCDEF - you provide your own macro
                            	    49: *------ to match your needs.  Here is an example:
                            	    50: *
                            	    51: *	FUNC_CNT	 EQU	LIB_USERDEF	* Skip 4 standard vectors
                            	    52: *	FUNCDEF		 MACRO
                            	    53: *	_LVO\1		 EQU	FUNC_CNT
                            	    54: *	FUNC_CNT	 SET	FUNC_CNT-6	* Standard offset-6 bytes each
                            	    55: *			 ENDM
                            	    56: 
                            	    57: *----------------------------------------------------------------
                            	    58: *
                            	    59: *   Standard Library Functions
                            	    60: *
                            	    61: *----------------------------------------------------------------
                            	    62: 
                            	    63:     LIBINIT LIB_BASE
                            	     1M             IFC     'LIB_BASE',''
                            	     2M COUNT_LIB   SET     LIB_USERDEF
                            	     3M             ENDC
                            	     4M             IFNC    'LIB_BASE',''
                            	     5M COUNT_LIB   SET     LIB_BASE
                            	     6M             ENDC
                            	    64: 
                            	    65:     LIBDEF  LIB_OPEN
                            	     1M LIB_OPEN          EQU     COUNT_LIB
                            	     2M COUNT_LIB   SET     COUNT_LIB-LIB_VECTSIZE
                            	    66:     LIBDEF  LIB_CLOSE
                            	     1M LIB_CLOSE          EQU     COUNT_LIB
                            	     2M COUNT_LIB   SET     COUNT_LIB-LIB_VECTSIZE
                            	    67:     LIBDEF  LIB_EXPUNGE ; must exist in all libraries
                            	     1M LIB_EXPUNGE          EQU     COUNT_LIB
                            	     2M COUNT_LIB   SET     COUNT_LIB-LIB_VECTSIZE
                            	    68:     LIBDEF  LIB_EXTFUNC	; for future expansion - must return zero.
                            	     1M LIB_EXTFUNC          EQU     COUNT_LIB
                            	     2M COUNT_LIB   SET     COUNT_LIB-LIB_VECTSIZE
                            	    69: 
                            	    70: 
                            	    71: *----------------------------------------------------------------
                            	    72: *
                            	    73: *   Library Base Structure Definition
                            	    74: *   Also used for Devices and some Resources
                            	    75: *
                            	    76: *----------------------------------------------------------------
                            	    77: 
                            	    78:  STRUCTURE LIB,LN_SIZE
                            	     1M LIB	    EQU     0
                            	     2M SOFFSET     SET     LN_SIZE
                            	    79:     UBYTE   LIB_FLAGS			; see below
                            	     1M LIB_FLAGS	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	    80:     UBYTE   LIB_pad			; must be zero
                            	     1M LIB_pad	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	    81:     UWORD   LIB_NEGSIZE                 ; number of bytes before LIB
                            	     1M LIB_NEGSIZE	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    82:     UWORD   LIB_POSSIZE                 ; number of bytes after LIB
                            	     1M LIB_POSSIZE	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    83:     UWORD   LIB_VERSION                 ; major
                            	     1M LIB_VERSION	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    84:     UWORD   LIB_REVISION                ; minor
                            	     1M LIB_REVISION	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    85:     APTR    LIB_IDSTRING                ; ASCII identification
                            	     1M LIB_IDSTRING	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    86:     ULONG   LIB_SUM                     ; the system-calculated checksum
                            	     1M LIB_SUM	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    87:     UWORD   LIB_OPENCNT                 ; number of current opens
                            	     1M LIB_OPENCNT	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    88:     LABEL   LIB_SIZE	;Warning: Size is not a longword multiple!
                            	     1M LIB_SIZE	    EQU     SOFFSET
                            	    89: 
                            	    90: *------ LIB_FLAGS bit definitions (all others are system reserved)
                            	    91:     BITDEF  LIB,SUMMING,0  ; system is currently checksumming
                            	     1M 	    BITDEF0 LIB,SUMMING,B_,0
                            	     1M LIBB_SUMMING	    EQU     0
                            	     2M _000071BITDEF    SET     1<<0
                            	     3M 	    BITDEF0 LIB,SUMMING,F_,_000071BITDEF
                            	     1M LIBF_SUMMING	    EQU     _000071BITDEF
                            	    92:     BITDEF  LIB,CHANGED,1  ; something has changed the library since last sum
                            	     1M 	    BITDEF0 LIB,CHANGED,B_,1
                            	     1M LIBB_CHANGED	    EQU     1
                            	     2M _000074BITDEF    SET     1<<1
                            	     3M 	    BITDEF0 LIB,CHANGED,F_,_000074BITDEF
                            	     1M LIBF_CHANGED	    EQU     _000074BITDEF
                            	    93:     BITDEF  LIB,SUMUSED,2  ; indicates if the library allows checksumming
                            	     1M 	    BITDEF0 LIB,SUMUSED,B_,2
                            	     1M LIBB_SUMUSED	    EQU     2
                            	     2M _000077BITDEF    SET     1<<2
                            	     3M 	    BITDEF0 LIB,SUMUSED,F_,_000077BITDEF
                            	     1M LIBF_SUMUSED	    EQU     _000077BITDEF
                            	    94:     BITDEF  LIB,DELEXP,3   ; delayed expunge flag (for use by library)
                            	     1M 	    BITDEF0 LIB,DELEXP,B_,3
                            	     1M LIBB_DELEXP	    EQU     3
                            	     2M _000080BITDEF    SET     1<<3
                            	     3M 	    BITDEF0 LIB,DELEXP,F_,_000080BITDEF
                            	     1M LIBF_DELEXP	    EQU     _000080BITDEF
                            	    95:     BITDEF  LIB,EXP0CNT,4  ; special system expunge flag.
                            	     1M 	    BITDEF0 LIB,EXP0CNT,B_,4
                            	     1M LIBB_EXP0CNT	    EQU     4
                            	     2M _000083BITDEF    SET     1<<4
                            	     3M 	    BITDEF0 LIB,EXP0CNT,F_,_000083BITDEF
                            	     1M LIBF_EXP0CNT	    EQU     _000083BITDEF
                            	    96: 
                            	    97: 
                            	    98: *---------------------------------------------------------------------------
                            	    99: *
                            	   100: *	Function Invocation Macros (for calling existing, opened, libraries)
                            	   101: *	Also see exec/macros.i
                            	   102: *
                            	   103: *---------------------------------------------------------------------------
                            	   104: 
                            	   105: *------ CALLLIB for calling functions where A6 is already correct:
                            	   106: 
                            	   107: CALLLIB     MACRO   ; functionOffset
                            	   108:         IFGT NARG-1
                            	   109:             FAIL    !!! CALLLIB - too many arguments !!!
                            	   110:         ENDC
                            	   111:             JSR     \1(A6)
                            	   112:             ENDM
                            	   113: 
                            	   114: 
                            	   115: *------ LINKLIB for calling functions where A6 is incorrect:
                            	   116: 
                            	   117: LINKLIB     MACRO   ; functionOffset,libraryBase
                            	   118:         IFGT NARG-2
                            	   119:             FAIL    !!! LINKLIB - too many arguments !!!
                            	   120:         ENDC
                            	   121:             MOVE.L  A6,-(SP)
                            	   122:             MOVE.L  \2,A6
                            	   123:             JSR     \1(A6)
                            	   124:             MOVE.L  (SP)+,A6
                            	   125:             ENDM
                            	   126: 
                            	   127: 	ENDC	; EXEC_LIBRARIES_I
                            	   128: 

Source: "exec\execbase.i"
                            	    26:     ENDC	; EXEC_LIBRARIES_I
                            	    27: 
                            	    28: 
                            	    29: 
                            	    30: ** Definition of the Exec library base structure (pointed to by location 4).
                            	    31: ** Most fields are not to be viewed or modified by user programs.  Use
                            	    32: ** extreme caution.
                            	    33: **
                            	    34:  STRUCTURE  ExecBase,LIB_SIZE		; Standard library node
                            	     1M ExecBase	    EQU     0
                            	     2M SOFFSET     SET     LIB_SIZE
                            	    35: 
                            	    36: ******* Static System Variables *********************************************
                            	    37: 
                            	    38: 	UWORD	SoftVer 	; kickstart release number (obs.)
                            	     1M SoftVer	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    39: 	WORD	LowMemChkSum	; checksum of 68000 trap vectors
                            	     1M LowMemChkSum	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    40: 	ULONG	ChkBase 	; system base pointer complement
                            	     1M ChkBase	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    41: 	APTR	ColdCapture	; coldstart soft capture vector
                            	     1M ColdCapture	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    42: 	APTR	CoolCapture	; coolstart soft capture vector
                            	     1M CoolCapture	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    43: 	APTR	WarmCapture	; warmstart soft capture vector
                            	     1M WarmCapture	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    44: 	APTR	SysStkUpper	; system stack base   (upper bound)
                            	     1M SysStkUpper	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    45: 	APTR	SysStkLower	; top of system stack (lower bound)
                            	     1M SysStkLower	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    46: 	ULONG	MaxLocMem	; top of chip memory
                            	     1M MaxLocMem	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    47: 	APTR	DebugEntry	; global debugger entry point
                            	     1M DebugEntry	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    48: 	APTR	DebugData	; global debugger data segment
                            	     1M DebugData	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    49: 	APTR	AlertData	; alert data segment
                            	     1M AlertData	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    50: 	APTR	MaxExtMem	; top of extended mem, or null if none
                            	     1M MaxExtMem	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    51: 
                            	    52: 	WORD	ChkSum		; for all of the above (minus 2)
                            	     1M ChkSum	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    53: 
                            	    54: 
                            	    55: ******* Interrupt Related ********************************************
                            	    56: 
                            	    57: 	LABEL	IntVects
                            	     1M IntVects	    EQU     SOFFSET
                            	    58: 	STRUCT	IVTBE,IV_SIZE
                            	     1M IVTBE	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+IV_SIZE
                            	    59: 	STRUCT	IVDSKBLK,IV_SIZE
                            	     1M IVDSKBLK	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+IV_SIZE
                            	    60: 	STRUCT	IVSOFTINT,IV_SIZE
                            	     1M IVSOFTINT	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+IV_SIZE
                            	    61: 	STRUCT	IVPORTS,IV_SIZE
                            	     1M IVPORTS	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+IV_SIZE
                            	    62: 	STRUCT	IVCOPER,IV_SIZE
                            	     1M IVCOPER	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+IV_SIZE
                            	    63: 	STRUCT	IVVERTB,IV_SIZE
                            	     1M IVVERTB	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+IV_SIZE
                            	    64: 	STRUCT	IVBLIT,IV_SIZE
                            	     1M IVBLIT	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+IV_SIZE
                            	    65: 	STRUCT	IVAUD0,IV_SIZE
                            	     1M IVAUD0	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+IV_SIZE
                            	    66: 	STRUCT	IVAUD1,IV_SIZE
                            	     1M IVAUD1	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+IV_SIZE
                            	    67: 	STRUCT	IVAUD2,IV_SIZE
                            	     1M IVAUD2	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+IV_SIZE
                            	    68: 	STRUCT	IVAUD3,IV_SIZE
                            	     1M IVAUD3	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+IV_SIZE
                            	    69: 	STRUCT	IVRBF,IV_SIZE
                            	     1M IVRBF	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+IV_SIZE
                            	    70: 	STRUCT	IVDSKSYNC,IV_SIZE
                            	     1M IVDSKSYNC	    EQU     SOFFSET
