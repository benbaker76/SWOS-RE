                            	   238: ; additional	Version 8+
                            	   239: ;=============================================================================
                            	   240: 
                            	   241: 	LONG	ws_ExpMem	;size of required expansions memory, during
                            	     1M ws_ExpMem	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   242: 				;initialization overwritten by WHDLoad with
                            	   243: 				;address of the memory (multiple of $1000)
                            	   244: 				;if negative it is optional
                            	   245: 
                            	   246: ;=============================================================================
                            	   247: ; additional	Version 10+
                            	   248: ;=============================================================================
                            	   249: 
                            	   250: 	RPTR	ws_name		;name of the installed program
                            	     1M ws_name	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	   251: 	RPTR	ws_copy		;year and owner of the copyright
                            	     1M ws_copy	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	   252: 	RPTR	ws_info		;additional informations (author, version ...)
                            	     1M ws_info	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
