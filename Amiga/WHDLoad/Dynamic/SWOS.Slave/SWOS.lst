                            	   199: ;=============================================================================
                            	   200: ;	structure returned by WHDLTAG_TIME_GET
                            	   201: ;=============================================================================
                            	   202: 
                            	   203:     STRUCTURE whdload_time,0
                            	     1M whdload_time	    EQU     0
                            	     2M SOFFSET     SET     0
                            	   204: 	ULONG	whdlt_days	;days since 1978-01-01
                            	     1M whdlt_days	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   205: 	ULONG	whdlt_mins	;minutes since last day
                            	     1M whdlt_mins	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   206: 	ULONG	whdlt_ticks	;1/50 seconds since last minute
                            	     1M whdlt_ticks	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   207: 	UBYTE	whdlt_year	;78..77 (1978..2077)
                            	     1M whdlt_year	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	   208: 	UBYTE	whdlt_month	;1..12
                            	     1M whdlt_month	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	   209: 	UBYTE	whdlt_day	;1..31
                            	     1M whdlt_day	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	   210: 	UBYTE	whdlt_hour	;0..23
                            	     1M whdlt_hour	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	   211: 	UBYTE	whdlt_min	;0..59
                            	     1M whdlt_min	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	   212: 	UBYTE	whdlt_sec	;0..59
                            	     1M whdlt_sec	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	   213: 	LABEL	whdlt_SIZEOF
                            	     1M whdlt_SIZEOF	    EQU     SOFFSET
                            	   214: 
                            	   215: ;=============================================================================
                            	   216: ; Slave		Version 1+
                            	   217: ;=============================================================================
                            	   218: 
                            	   219:     STRUCTURE	WHDLoadSlave,0
                            	     1M WHDLoadSlave	    EQU     0
                            	     2M SOFFSET     SET     0
                            	   220: 	STRUCT	ws_Security,4	;moveq #-1,d0 rts
                            	     1M ws_Security	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   221: 	STRUCT	ws_ID,8		;"WHDLOADS"
                            	     1M ws_ID	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+8
                            	   222: 	UWORD	ws_Version	;required WHDLoad version
                            	     1M ws_Version	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	   223: 	UWORD	ws_Flags	;see below
                            	     1M ws_Flags	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	   224: 	ULONG	ws_BaseMemSize	;size of required memory (multiple of $1000)
                            	     1M ws_BaseMemSize	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   225: 	ULONG	ws_ExecInstall	;must be 0
                            	     1M ws_ExecInstall	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   226: 	RPTR	ws_GameLoader	;Slave code, called by WHDLoad
                            	     1M ws_GameLoader	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	   227: 	RPTR	ws_CurrentDir	;subdirectory for data files
                            	     1M ws_CurrentDir	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	   228: 	RPTR	ws_DontCache	;pattern for files not to cache
                            	     1M ws_DontCache	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
