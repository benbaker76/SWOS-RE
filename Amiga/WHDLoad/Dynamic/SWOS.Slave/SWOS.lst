                            	   220: INSTALL_CALLBACK MACRO
                            	   221:     ; A0 = base of relocated SWOS2
                            	   222:     lea     \1(a0),a1         ; A1 -> stub (jsr 0; rts)
                            	   223:     lea     \2(pc),a2         ; A2 = callback address in Slave
                            	   224:     move.l  a2,(2,a1)         ; patch jsr operand
                            	   225:     ENDM
                            	   226: 
                            	   227: install_callbacks:
                            	   228:     INSTALL_CALLBACK  STUB_FIX_SNOOP_BUG,      fix_snoop_bug
                            	     1M     ; A0 = base of relocated SWOS2
