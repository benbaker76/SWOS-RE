                            	     2: HARDWARE_CIA_I	SET	1
                            	     3: **
                            	     4: **	$VER: cia.i 47.1 (1.8.2019)
                            	     5: **
                            	     6: **	registers and bits in the Complex Interface Adapter (CIA) chip
                            	     7: **
                            	     8: **	Copyright (C) 2019 Hyperion Entertainment CVBA.
                            	     9: **	    Developed under license.
                            	    10: **
                            	    11: 
                            	    12: *
                            	    13: * _ciaa is on an ODD address (e.g. the low byte) -- $bfe001
                            	    14: * _ciab is on an EVEN address (e.g. the high byte) -- $bfd000
                            	    15: *
                            	    16: * do this to get the definitions:
                            	    17: *    XREF _ciaa
                            	    18: *    XREF _ciab
                            	    19: *
                            	    20: 
                            	    21: 
                            	    22: * cia register offsets
                            	    23: ciapra		  EQU	$0000
                            	    24: ciaprb		  EQU	$0100
                            	    25: ciaddra	  EQU	$0200
                            	    26: ciaddrb	  EQU	$0300
                            	    27: ciatalo	  EQU	$0400
                            	    28: ciatahi	  EQU	$0500
                            	    29: ciatblo	  EQU	$0600
                            	    30: ciatbhi	  EQU	$0700
                            	    31: ciatodlow	  EQU	$0800
                            	    32: ciatodmid	  EQU	$0900
                            	    33: ciatodhi	  EQU	$0A00
                            	    34: ciasdr		  EQU	$0C00
                            	    35: ciaicr		  EQU	$0D00
                            	    36: ciacra		  EQU	$0E00
                            	    37: ciacrb		  EQU	$0F00
                            	    38: 
                            	    39: * interrupt control register bit numbers
                            	    40: CIAICRB_TA	  EQU	0
                            	    41: CIAICRB_TB	  EQU	1
                            	    42: CIAICRB_ALRM	  EQU	2
                            	    43: CIAICRB_SP	  EQU	3
                            	    44: CIAICRB_FLG	  EQU	4
                            	    45: CIAICRB_IR	  EQU	7
                            	    46: CIAICRB_SETCLR	  EQU	7
                            	    47: 
                            	    48: * control register A bit numbers
                            	    49: CIACRAB_START	  EQU	0
                            	    50: CIACRAB_PBON	  EQU	1
                            	    51: CIACRAB_OUTMODE   EQU	2
                            	    52: CIACRAB_RUNMODE   EQU	3
                            	    53: CIACRAB_LOAD	  EQU	4
                            	    54: CIACRAB_INMODE	  EQU	5
                            	    55: CIACRAB_SPMODE	  EQU	6
                            	    56: CIACRAB_TODIN	  EQU	7
                            	    57: 
                            	    58: * control register B bit numbers
                            	    59: CIACRBB_START	  EQU	0
                            	    60: CIACRBB_PBON	  EQU	1
                            	    61: CIACRBB_OUTMODE   EQU	2
                            	    62: CIACRBB_RUNMODE   EQU	3
                            	    63: CIACRBB_LOAD	  EQU	4
                            	    64: CIACRBB_INMODE0   EQU	5
                            	    65: CIACRBB_INMODE1   EQU	6
                            	    66: CIACRBB_ALARM	  EQU	7
                            	    67: 
                            	    68: * interrupt control register bit masks
                            	    69: CIAICRF_TA	  EQU	(1<<0)
                            	    70: CIAICRF_TB	  EQU	(1<<1)
                            	    71: CIAICRF_ALRM	  EQU	(1<<2)
                            	    72: CIAICRF_SP	  EQU	(1<<3)
                            	    73: CIAICRF_FLG	  EQU	(1<<4)
                            	    74: CIAICRF_IR	  EQU	(1<<7)
                            	    75: CIAICRF_SETCLR	  EQU	(1<<7)
                            	    76: 
                            	    77: * control register A bit masks
                            	    78: CIACRAF_START	  EQU	(1<<0)
                            	    79: CIACRAF_PBON	  EQU	(1<<1)
                            	    80: CIACRAF_OUTMODE   EQU	(1<<2)
                            	    81: CIACRAF_RUNMODE   EQU	(1<<3)
                            	    82: CIACRAF_LOAD	  EQU	(1<<4)
                            	    83: CIACRAF_INMODE	  EQU	(1<<5)
                            	    84: CIACRAF_SPMODE	  EQU	(1<<6)
                            	    85: CIACRAF_TODIN	  EQU	(1<<7)
                            	    86: 
                            	    87: * control register B bit masks
                            	    88: CIACRBF_START	  EQU	(1<<0)
                            	    89: CIACRBF_PBON	  EQU	(1<<1)
                            	    90: CIACRBF_OUTMODE   EQU	(1<<2)
                            	    91: CIACRBF_RUNMODE   EQU	(1<<3)
                            	    92: CIACRBF_LOAD	  EQU	(1<<4)
                            	    93: CIACRBF_INMODE0   EQU	(1<<5)
                            	    94: CIACRBF_INMODE1   EQU	(1<<6)
                            	    95: CIACRBF_ALARM	  EQU	(1<<7)
                            	    96: 
                            	    97: * control register B INMODE masks
                            	    98: CIACRBF_IN_PHI2   EQU	0
                            	    99: CIACRBF_IN_CNT	  EQU	(CIACRBF_INMODE0)
                            	   100: CIACRBF_IN_TA	  EQU	(CIACRBF_INMODE1)
                            	   101: CIACRBF_IN_CNT_TA EQU	(CIACRBF_INMODE0!CIACRBF_INMODE1)
                            	   102: 
                            	   103: 
                            	   104: *
                            	   105: * Port definitions -- what each bit in a cia peripheral register is tied to
                            	   106: *
                            	   107: 
                            	   108: * ciaa port A (0xbfe001)
                            	   109: CIAB_GAMEPORT1	  EQU	(7)   * gameport 1, pin 6 (fire button*)
                            	   110: CIAB_GAMEPORT0	  EQU	(6)   * gameport 0, pin 6 (fire button*)
                            	   111: CIAB_DSKRDY	  EQU	(5)   * disk ready*
                            	   112: CIAB_DSKTRACK0	  EQU	(4)   * disk on track 00*
                            	   113: CIAB_DSKPROT	  EQU	(3)   * disk write protect*
                            	   114: CIAB_DSKCHANGE	  EQU	(2)   * disk change*
                            	   115: CIAB_LED	  EQU	(1)   * led light control (0==>bright)
                            	   116: CIAB_OVERLAY	  EQU	(0)   * memory overlay bit
                            	   117: 
                            	   118: * ciaa port B (0xbfe101) -- parallel port
                            	   119: 
                            	   120: * ciab port A (0xbfd000) -- serial and printer control
                            	   121: CIAB_COMDTR	  EQU	(7)   * serial Data Terminal Ready*
                            	   122: CIAB_COMRTS	  EQU	(6)   * serial Request to Send*
                            	   123: CIAB_COMCD	  EQU	(5)   * serial Carrier Detect*
                            	   124: CIAB_COMCTS	  EQU	(4)   * serial Clear to Send*
                            	   125: CIAB_COMDSR	  EQU	(3)   * serial Data Set Ready*
                            	   126: CIAB_PRTRSEL	  EQU	(2)   * printer SELECT
                            	   127: CIAB_PRTRPOUT	  EQU	(1)   * printer paper out
                            	   128: CIAB_PRTRBUSY	  EQU	(0)   * printer busy
                            	   129: 
                            	   130: * ciab port B (0xbfd100) -- disk control
                            	   131: CIAB_DSKMOTOR	  EQU	(7)   * disk motorr*
                            	   132: CIAB_DSKSEL3	  EQU	(6)   * disk select unit 3*
                            	   133: CIAB_DSKSEL2	  EQU	(5)   * disk select unit 2*
                            	   134: CIAB_DSKSEL1	  EQU	(4)   * disk select unit 1*
                            	   135: CIAB_DSKSEL0	  EQU	(3)   * disk select unit 0*
                            	   136: CIAB_DSKSIDE	  EQU	(2)   * disk side select*
                            	   137: CIAB_DSKDIREC	  EQU	(1)   * disk direction of seek*
                            	   138: CIAB_DSKSTEP	  EQU	(0)   * disk step heads*
                            	   139: 
                            	   140: * ciaa port A (0xbfe001)
                            	   141: CIAF_GAMEPORT1	  EQU	(1<<7)
                            	   142: CIAF_GAMEPORT0	  EQU	(1<<6)
                            	   143: CIAF_DSKRDY	  EQU	(1<<5)
                            	   144: CIAF_DSKTRACK0	  EQU	(1<<4)
                            	   145: CIAF_DSKPROT	  EQU	(1<<3)
                            	   146: CIAF_DSKCHANGE	  EQU	(1<<2)
                            	   147: CIAF_LED	  EQU	(1<<1)
                            	   148: CIAF_OVERLAY	  EQU	(1<<0)
                            	   149: 
                            	   150: * ciaa port B (0xbfe101) -- parallel port
                            	   151: 
                            	   152: * ciab port A (0xbfd000) -- serial and printer control
                            	   153: CIAF_COMDTR	  EQU	(1<<7)
                            	   154: CIAF_COMRTS	  EQU	(1<<6)
                            	   155: CIAF_COMCD	  EQU	(1<<5)
                            	   156: CIAF_COMCTS	  EQU	(1<<4)
                            	   157: CIAF_COMDSR	  EQU	(1<<3)
                            	   158: CIAF_PRTRSEL	  EQU	(1<<2)
                            	   159: CIAF_PRTRPOUT	  EQU	(1<<1)
                            	   160: CIAF_PRTRBUSY	  EQU	(1<<0)
                            	   161: 
                            	   162: * ciab port B (0xbfd100) -- disk control
                            	   163: CIAF_DSKMOTOR	  EQU	(1<<7)
                            	   164: CIAF_DSKSEL3	  EQU	(1<<6)
                            	   165: CIAF_DSKSEL2	  EQU	(1<<5)
                            	   166: CIAF_DSKSEL1	  EQU	(1<<4)
                            	   167: CIAF_DSKSEL0	  EQU	(1<<3)
                            	   168: CIAF_DSKSIDE	  EQU	(1<<2)
                            	   169: CIAF_DSKDIREC	  EQU	(1<<1)
                            	   170: CIAF_DSKSTEP	  EQU	(1<<0)
                            	   171: 
                            	   172: 	ENDC	; HARDWARE_CIA_I
                            	   173: 

Source: "whdmacros.i"
                            	    25: 	ENDC
                            	    26: 	IFND	HARDWARE_CUSTOM_I
                            	    27: 	INCLUDE	hardware/custom.i

Source: "hardware\custom.i"
                            	     1: 	IFND	HARDWARE_CUSTOM_I
                            	     2: HARDWARE_CUSTOM_I	SET	1
                            	     3: **
                            	     4: **	$VER: custom.i 47.1 (1.8.2019)
                            	     5: **
                            	     6: **      Offsets of Amiga custom chip registers
                            	     7: **
                            	     8: **	Copyright (C) 2019 Hyperion Entertainment CVBA.
                            	     9: **	    Developed under license.
                            	    10: **
                            	    11: 
                            	    12: *
                            	    13: * do this to get base of custom registers:
                            	    14: *  XREF _custom;
                            	    15: *
                            	    16: 
                            	    17: bltddat     EQU   $000
                            	    18: dmaconr     EQU   $002
                            	    19: vposr	    EQU   $004
                            	    20: vhposr	    EQU   $006
                            	    21: dskdatr     EQU   $008
                            	    22: joy0dat     EQU   $00A
                            	    23: joy1dat     EQU   $00C
                            	    24: clxdat	    EQU   $00E
                            	    25: 
                            	    26: adkconr     EQU   $010
                            	    27: pot0dat     EQU   $012
                            	    28: pot1dat     EQU   $014
                            	    29: potinp	    EQU   $016
                            	    30: serdatr     EQU   $018
                            	    31: dskbytr     EQU   $01A
                            	    32: intenar     EQU   $01C
                            	    33: intreqr     EQU   $01E
                            	    34: 
                            	    35: dskpt	    EQU   $020
                            	    36: dsklen	    EQU   $024
                            	    37: dskdat	    EQU   $026
                            	    38: refptr	    EQU   $028
                            	    39: vposw	    EQU   $02A
                            	    40: vhposw	    EQU   $02C
                            	    41: copcon	    EQU   $02E
                            	    42: serdat	    EQU   $030
                            	    43: serper	    EQU   $032
                            	    44: potgo	    EQU   $034
                            	    45: joytest     EQU   $036
                            	    46: strequ	    EQU   $038
                            	    47: strvbl	    EQU   $03A
                            	    48: strhor	    EQU   $03C
                            	    49: strlong     EQU   $03E
                            	    50: 
                            	    51: bltcon0     EQU   $040
                            	    52: bltcon1     EQU   $042
                            	    53: bltafwm     EQU   $044
                            	    54: bltalwm     EQU   $046
                            	    55: bltcpt	    EQU   $048
                            	    56: bltbpt	    EQU   $04C
                            	    57: bltapt	    EQU   $050
                            	    58: bltdpt	    EQU   $054
                            	    59: bltsize     EQU   $058
                            	    60: bltcon0l    EQU   $05B		; note: byte access only
                            	    61: bltsizv     EQU   $05C
                            	    62: bltsizh     EQU   $05E
                            	    63: 
                            	    64: bltcmod     EQU   $060
                            	    65: bltbmod     EQU   $062
                            	    66: bltamod     EQU   $064
                            	    67: bltdmod     EQU   $066
                            	    68: 
                            	    69: bltcdat     EQU   $070
                            	    70: bltbdat     EQU   $072
                            	    71: bltadat     EQU   $074
                            	    72: 
                            	    73: deniseid    EQU   $07C
                            	    74: dsksync     EQU   $07E
                            	    75: 
                            	    76: cop1lc	    EQU   $080
                            	    77: cop2lc	    EQU   $084
                            	    78: copjmp1     EQU   $088
                            	    79: copjmp2     EQU   $08A
                            	    80: copins	    EQU   $08C
                            	    81: diwstrt     EQU   $08E
                            	    82: diwstop     EQU   $090
                            	    83: ddfstrt     EQU   $092
                            	    84: ddfstop     EQU   $094
                            	    85: dmacon	    EQU   $096
                            	    86: clxcon	    EQU   $098
                            	    87: intena	    EQU   $09A
                            	    88: intreq	    EQU   $09C
                            	    89: adkcon	    EQU   $09E
                            	    90: 
                            	    91: aud	    EQU   $0A0
                            	    92: aud0	    EQU   $0A0
                            	    93: aud1	    EQU   $0B0
                            	    94: aud2	    EQU   $0C0
                            	    95: aud3	    EQU   $0D0
                            	    96: 
                            	    97: * AudChannel
                            	    98: ac_ptr	    EQU   $00	; ptr to start of waveform data
                            	    99: ac_len	    EQU   $04	; length of waveform in words
                            	   100: ac_per	    EQU   $06	; sample period
                            	   101: ac_vol	    EQU   $08	; volume
                            	   102: ac_dat	    EQU   $0A	; sample pair
                            	   103: ac_SIZEOF   EQU   $10
                            	   104: 
                            	   105: bplpt	    EQU   $0E0
                            	   106: 
                            	   107: bplcon0     EQU   $100
                            	   108: bplcon1     EQU   $102
                            	   109: bplcon2     EQU   $104
                            	   110: bplcon3     EQU   $106
                            	   111: bpl1mod     EQU   $108
                            	   112: bpl2mod     EQU   $10A
                            	   113: bplcon4     EQU   $10C
                            	   114: clxcon2     EQU   $10E
                            	   115: 
                            	   116: bpldat	    EQU   $110
                            	   117: 
                            	   118: sprpt	    EQU   $120
                            	   119: 
                            	   120: spr	    EQU   $140
                            	   121: 
                            	   122: * SpriteDef
                            	   123: sd_pos	    EQU   $00
                            	   124: sd_ctl	    EQU   $02
                            	   125: sd_dataa    EQU   $04
                            	   126: sd_dataB    EQU   $06
                            	   127: sd_SIZEOF   EQU   $08
                            	   128: 
                            	   129: color	    EQU   $180
                            	   130: 
                            	   131: htotal	    EQU   $1c0
                            	   132: hsstop	    EQU   $1c2
                            	   133: hbstrt	    EQU   $1c4
                            	   134: hbstop	    EQU   $1c6
                            	   135: vtotal	    EQU   $1c8
                            	   136: vsstop	    EQU   $1ca
                            	   137: vbstrt	    EQU   $1cc
                            	   138: vbstop	    EQU   $1ce
                            	   139: sprhstrt    EQU   $1d0
                            	   140: sprhstop    EQU   $1d2
                            	   141: bplhstrt    EQU   $1d4
                            	   142: bplhstop    EQU   $1d6
                            	   143: hhposw	    EQU   $1d8
                            	   144: hhposr	    EQU   $1da
                            	   145: beamcon0    EQU   $1dc
                            	   146: hsstrt	    EQU   $1de
                            	   147: vsstrt	    EQU   $1e0
                            	   148: hcenter     EQU   $1e2
                            	   149: diwhigh     EQU   $1e4
                            	   150: fmode	    EQU   $1fc
                            	   151: 
                            	   152:    ENDC  !HARDWARE_CUSTOM_I
                            	   153: 

Source: "whdmacros.i"
                            	    28: 	ENDC
                            	    29: 	IFND	HARDWARE_INTBITS_I
                            	    30: 	INCLUDE	hardware/intbits.i

Source: "hardware\intbits.i"
                            	     1: 	IFND	HARDWARE_INTBITS_I
                            	     2: HARDWARE_INTBITS_I	SET	1
                            	     3: **
                            	     4: **	$VER: intbits.i 47.1 (1.8.2019)
                            	     5: **
                            	     6: **	bits in the interrupt enable (and interrupt request) register
                            	     7: **
                            	     8: **	Copyright (C) 2019 Hyperion Entertainment CVBA.
                            	     9: **	    Developed under license.
                            	    10: **
                            	    11: 
                            	    12: INTB_SETCLR    EQU   (15)  ;Set/Clear control bit. Determines if bits
                            	    13: 			   ;written with a 1 get set or cleared. Bits
                            	    14: 			   ;written with a zero are allways unchanged.
                            	    15: INTB_INTEN     EQU   (14)  ;Master interrupt (enable only )
                            	    16: INTB_EXTER     EQU   (13)  ;External interrupt
                            	    17: INTB_DSKSYNC   EQU   (12)  ;Disk re-SYNChronized
                            	    18: INTB_RBF       EQU   (11)  ;serial port Receive Buffer Full
                            	    19: INTB_AUD3      EQU   (10)  ;Audio channel 3 block finished
                            	    20: INTB_AUD2      EQU   (9)   ;Audio channel 2 block finished
                            	    21: INTB_AUD1      EQU   (8)   ;Audio channel 1 block finished
                            	    22: INTB_AUD0      EQU   (7)   ;Audio channel 0 block finished
                            	    23: INTB_BLIT      EQU   (6)   ;Blitter finished
                            	    24: INTB_VERTB     EQU   (5)   ;start of Vertical Blank
                            	    25: INTB_COPER     EQU   (4)   ;Coprocessor
                            	    26: INTB_PORTS     EQU   (3)   ;I/O Ports and timers
                            	    27: INTB_SOFTINT   EQU   (2)   ;software interrupt request
                            	    28: INTB_DSKBLK    EQU   (1)   ;Disk Block done
                            	    29: INTB_TBE       EQU   (0)   ;serial port Transmit Buffer Empty
                            	    30: 
                            	    31: 
                            	    32: 
                            	    33: INTF_SETCLR    EQU   (1<<15)
                            	    34: INTF_INTEN     EQU   (1<<14)
                            	    35: INTF_EXTER     EQU   (1<<13)
                            	    36: INTF_DSKSYNC   EQU   (1<<12)
                            	    37: INTF_RBF       EQU   (1<<11)
                            	    38: INTF_AUD3      EQU   (1<<10)
                            	    39: INTF_AUD2      EQU   (1<<9)
                            	    40: INTF_AUD1      EQU   (1<<8)
                            	    41: INTF_AUD0      EQU   (1<<7)
                            	    42: INTF_BLIT      EQU   (1<<6)
                            	    43: INTF_VERTB     EQU   (1<<5)
                            	    44: INTF_COPER     EQU   (1<<4)
                            	    45: INTF_PORTS     EQU   (1<<3)
                            	    46: INTF_SOFTINT   EQU   (1<<2)
                            	    47: INTF_DSKBLK    EQU   (1<<1)
                            	    48: INTF_TBE       EQU   (1<<0)
                            	    49: 
                            	    50: 	ENDC	; HARDWARE_INTBITS_I
                            	    51: 

Source: "whdmacros.i"
                            	    31: 	ENDC
                            	    32: 	IFND	HARDWARE_DMABITS_I
                            	    33: 	INCLUDE	hardware/dmabits.i

Source: "hardware\dmabits.i"
                            	     1: 	IFND	HARDWARE_DMABITS_I
                            	     2: HARDWARE_DMABITS_I	SET	1
                            	     3: **
                            	     4: **	$VER: dmabits.i 47.1 (1.8.2019)
                            	     5: **
                            	     6: **	include file for defining dma control stuff
                            	     7: **
                            	     8: **	Copyright (C) 2019 Hyperion Entertainment CVBA.
                            	     9: **	    Developed under license.
                            	    10: **
                            	    11: 
                            	    12: * write definitions for dmaconw
                            	    13: DMAF_SETCLR    EQU   $8000
                            	    14: DMAF_AUDIO     EQU   $000F  * 4 bit mask
                            	    15: DMAF_AUD0      EQU   $0001
                            	    16: DMAF_AUD1      EQU   $0002
                            	    17: DMAF_AUD2      EQU   $0004
                            	    18: DMAF_AUD3      EQU   $0008
                            	    19: DMAF_DISK      EQU   $0010
                            	    20: DMAF_SPRITE    EQU   $0020
                            	    21: DMAF_BLITTER   EQU   $0040
                            	    22: DMAF_COPPER    EQU   $0080
                            	    23: DMAF_RASTER    EQU   $0100
                            	    24: DMAF_MASTER    EQU   $0200
                            	    25: DMAF_BLITHOG   EQU   $0400
                            	    26: DMAF_ALL       EQU   $01FF  * all dma channels
                            	    27: 
                            	    28: * read definitions for dmaconr
                            	    29: * bits 0-8 correspnd to dmaconw definitions
                            	    30: DMAF_BLTDONE   EQU   $4000
                            	    31: DMAF_BLTNZERO  EQU   $2000
                            	    32: 
                            	    33: DMAB_SETCLR    EQU   15
                            	    34: DMAB_AUD0      EQU   0
                            	    35: DMAB_AUD1      EQU   1
                            	    36: DMAB_AUD2      EQU   2
                            	    37: DMAB_AUD3      EQU   3
                            	    38: DMAB_DISK      EQU   4
                            	    39: DMAB_SPRITE    EQU   5
                            	    40: DMAB_BLITTER   EQU   6
                            	    41: DMAB_COPPER    EQU   7
                            	    42: DMAB_RASTER    EQU   8
                            	    43: DMAB_MASTER    EQU   9
                            	    44: DMAB_BLITHOG   EQU   10
                            	    45: DMAB_BLTDONE   EQU   14
                            	    46: DMAB_BLTNZERO  EQU   13
                            	    47: 
                            	    48: 	ENDC	; HARDWARE_DMABITS_I
                            	    49: 

Source: "whdmacros.i"
                            	    34: 	ENDC
                            	    35: 	IFND	EXEC_TYPES_I
                            	    36: 	INCLUDE	exec/types.i
                            	    37: 	ENDC
                            	    38: 
                            	    39: ;=============================================================================
                            	    40: 
                            	    41:  BITDEF POTGO,OUTRY,15
                            	     1M 	    BITDEF0 POTGO,OUTRY,B_,15
                            	     1M POTGOB_OUTRY	    EQU     15
                            	     2M _000636BITDEF    SET     1<<15
                            	     3M 	    BITDEF0 POTGO,OUTRY,F_,_000636BITDEF
                            	     1M POTGOF_OUTRY	    EQU     _000636BITDEF
                            	    42:  BITDEF POTGO,DATRY,14
                            	     1M 	    BITDEF0 POTGO,DATRY,B_,14
                            	     1M POTGOB_DATRY	    EQU     14
                            	     2M _000639BITDEF    SET     1<<14
                            	     3M 	    BITDEF0 POTGO,DATRY,F_,_000639BITDEF
                            	     1M POTGOF_DATRY	    EQU     _000639BITDEF
                            	    43:  BITDEF POTGO,OUTRX,13
                            	     1M 	    BITDEF0 POTGO,OUTRX,B_,13
                            	     1M POTGOB_OUTRX	    EQU     13
                            	     2M _000642BITDEF    SET     1<<13
                            	     3M 	    BITDEF0 POTGO,OUTRX,F_,_000642BITDEF
                            	     1M POTGOF_OUTRX	    EQU     _000642BITDEF
                            	    44:  BITDEF POTGO,DATRX,12
                            	     1M 	    BITDEF0 POTGO,DATRX,B_,12
                            	     1M POTGOB_DATRX	    EQU     12
                            	     2M _000645BITDEF    SET     1<<12
                            	     3M 	    BITDEF0 POTGO,DATRX,F_,_000645BITDEF
                            	     1M POTGOF_DATRX	    EQU     _000645BITDEF
                            	    45:  BITDEF POTGO,OUTLY,11
                            	     1M 	    BITDEF0 POTGO,OUTLY,B_,11
                            	     1M POTGOB_OUTLY	    EQU     11
                            	     2M _000648BITDEF    SET     1<<11
                            	     3M 	    BITDEF0 POTGO,OUTLY,F_,_000648BITDEF
                            	     1M POTGOF_OUTLY	    EQU     _000648BITDEF
                            	    46:  BITDEF POTGO,DATLY,10
                            	     1M 	    BITDEF0 POTGO,DATLY,B_,10
                            	     1M POTGOB_DATLY	    EQU     10
                            	     2M _000651BITDEF    SET     1<<10
                            	     3M 	    BITDEF0 POTGO,DATLY,F_,_000651BITDEF
                            	     1M POTGOF_DATLY	    EQU     _000651BITDEF
                            	    47:  BITDEF POTGO,OUTLX,9
                            	     1M 	    BITDEF0 POTGO,OUTLX,B_,9
                            	     1M POTGOB_OUTLX	    EQU     9
                            	     2M _000654BITDEF    SET     1<<9
                            	     3M 	    BITDEF0 POTGO,OUTLX,F_,_000654BITDEF
                            	     1M POTGOF_OUTLX	    EQU     _000654BITDEF
                            	    48:  BITDEF POTGO,DATLX,8
                            	     1M 	    BITDEF0 POTGO,DATLX,B_,8
                            	     1M POTGOB_DATLX	    EQU     8
                            	     2M _000657BITDEF    SET     1<<8
                            	     3M 	    BITDEF0 POTGO,DATLX,F_,_000657BITDEF
                            	     1M POTGOF_DATLX	    EQU     _000657BITDEF
                            	    49:  BITDEF POTGO,START,0
                            	     1M 	    BITDEF0 POTGO,START,B_,0
                            	     1M POTGOB_START	    EQU     0
                            	     2M _000660BITDEF    SET     1<<0
                            	     3M 	    BITDEF0 POTGO,START,F_,_000660BITDEF
                            	     1M POTGOF_START	    EQU     _000660BITDEF
                            	    50: 
                            	    51: _ciaa		= $bfe001
                            	    52: _ciab		= $bfd000
                            	    53: _custom		= $dff000
                            	    54: 
                            	    55: ****************************************************************
                            	    56: ***** write opcode ILLEGAL to specified address
                            	    57: ill	MACRO
                            	    58: 	IFNE	NARG-1
                            	    59: 		FAIL	"ill: too many arguments"
                            	    60: 	ENDC
                            	    61: 		move.w	#$4afc,\1
                            	    62: 	ENDM
                            	    63: 
                            	    64: ****************************************************************
                            	    65: ***** write opcode RTS to specified address
                            	    66: ret	MACRO
                            	    67: 	IFNE	NARG-1
                            	    68: 		FAIL	"ret: too many arguments"
                            	    69: 	ENDC
                            	    70: 		move.w	#$4e75,\1
                            	    71: 	ENDM
                            	    72: 
                            	    73: ****************************************************************
                            	    74: ***** skip \1 instruction bytes on address \2
                            	    75: skip	MACRO
                            	    76: 	IFNE	NARG-2
                            	    77: 		FAIL	"skip: wrong amount of arguments"
                            	    78: 	ENDC
                            	    79: 	IFNE \1&1
                            	    80: 		FAIL	"skip: argument not even"
                            	    81: 	ENDC
                            	    82: 	IFEQ \1-2
                            	    83: 		move.w	#$4e71,\2
                            	    84: 	ELSE
                            	    85: 	IFLE \1-126
                            	    86: 		move.w	#$6000+\1-2,\2
                            	    87: 	ELSE
                            	    88: 	IFLE \1-32766
                            	    89: 		move.l	#$60000000+\1-2,\2
                            	    90: 	ELSE
                            	    91: 		FAIL	"skip: distance to large, max 32766"
                            	    92: 	ENDC
                            	    93: 	ENDC
                            	    94: 	ENDC
                            	    95: 	ENDM
                            	    96: 
                            	    97: ****************************************************************
                            	    98: ***** write \1 times opcode NOP starting at address \2
                            	    99: ***** (better to use "skip" instead)
                            	   100: nops	MACRO
                            	   101: 	IFNE	NARG-2
                            	   102: 		FAIL	"nops: wrong amount of arguments"
                            	   103: 	ENDC
                            	   104: 		movem.l	d0/a0,-(a7)
                            	   105: 		IFGT \1-127
                            	   106: 			move.w	#\1-1,d0
                            	   107: 		ELSE
                            	   108: 			moveq	#\1-1,d0
                            	   109: 		ENDC
                            	   110: 		lea	\2,a0
                            	   111: .lp\@		move.w	#$4e71,(a0)+
                            	   112: 		dbf	d0,.lp\@
                            	   113: 		movem.l	(a7)+,d0/a0
                            	   114: 	ENDM
                            	   115: 
                            	   116: ****************************************************************
                            	   117: ***** write opcode JMP \2 to address \1
                            	   118: patch	MACRO
                            	   119: 	IFNE	NARG-2
                            	   120: 		FAIL	"patch: wrong amount of arguments"
                            	   121: 	ENDC
                            	   122: 		move.w	#$4ef9,\1
                            	   123: 		pea	(\2,pc)
                            	   124: 		move.l	(a7)+,2+\1
                            	   125: 	ENDM
                            	   126: 
                            	   127: ****************************************************************
                            	   128: ***** write opcode NOP + JMP \2 to address \1
                            	   129: patch2	MACRO
                            	   130: 	IFNE	NARG-2
                            	   131: 		FAIL	"patch2: wrong amount of arguments"
                            	   132: 	ENDC
                            	   133: 		move.l	#$4e714ef9,\1
                            	   134: 		pea	(\2,pc)
                            	   135: 		move.l	(a7)+,4+\1
                            	   136: 	ENDM
                            	   137: 
                            	   138: ****************************************************************
                            	   139: ***** write opcode JSR \2 to address \1
                            	   140: patchs	MACRO
                            	   141: 	IFNE	NARG-2
                            	   142: 		FAIL	"patchs: wrong amount of arguments"
                            	   143: 	ENDC
                            	   144: 		move.w	#$4eb9,\1
                            	   145: 		pea	(\2,pc)
                            	   146: 		move.l	(a7)+,2+\1
                            	   147: 	ENDM
                            	   148: 
                            	   149: ****************************************************************
                            	   150: ***** write opcode NOP + JSR \2 to address \1
                            	   151: patchs2	MACRO
                            	   152: 	IFNE	NARG-2
                            	   153: 		FAIL	"patchs2: wrong amount of arguments"
                            	   154: 	ENDC
                            	   155: 		move.w	#$4e714eb9,\1
                            	   156: 		pea	(\2,pc)
                            	   157: 		move.l	(a7)+,4+\1
                            	   158: 	ENDM
                            	   159: 
                            	   160: ****************************************************************
                            	   161: ***** wait that blitter has finished his job
                            	   162: ***** (this is adapted from graphics.WaitBlit, see autodocs for
                            	   163: *****  hardware bugs/caveats and check eab thread 31758)
                            	   164: ***** if \1 is given it must be an address register containing _custom
                            	   165: BLITWAIT MACRO
                            	   166: 	IFEQ	NARG-1
                            	   167: 		tst.b	(dmaconr,\1)
                            	   168: 		btst	#DMAB_BLTDONE-8,(dmaconr,\1)
                            	   169: 		beq.b	.1\@
                            	   170: .2\@		tst.b	(_ciaa)		;this avoids blitter slow down
                            	   171: 		tst.b	(_ciaa)		;this avoids blitter slow down
                            	   172: 		tst.b	(_ciaa)		;this avoids blitter slow down
                            	   173: 		tst.b	(_ciaa)		;this avoids blitter slow down
                            	   174: 		btst	#DMAB_BLTDONE-8,(dmaconr,\1)
                            	   175: 		bne.b	.2\@
                            	   176: .1\@		tst.b	(dmaconr,\1)
                            	   177: 	ELSE
                            	   178: 		tst.b	(_custom+dmaconr)
                            	   179: 		btst	#DMAB_BLTDONE-8,(_custom+dmaconr)
                            	   180: 		beq.b	.1\@
                            	   181: .2\@		tst.b	(_ciaa)		;this avoids blitter slow down
                            	   182: 		tst.b	(_ciaa)		;this avoids blitter slow down
                            	   183: 		tst.b	(_ciaa)		;this avoids blitter slow down
                            	   184: 		tst.b	(_ciaa)		;this avoids blitter slow down
                            	   185: 		btst	#DMAB_BLTDONE-8,(_custom+dmaconr)
                            	   186: 		bne.b	.2\@
                            	   187: .1\@		tst.b	(_custom+dmaconr)
                            	   188: 	ENDC
                            	   189: 	ENDM
                            	   190: 
                            	   191: ****************************************************************
                            	   192: ***** wait of vertical blank
                            	   193: ***** if \1 is given it must be an address register containing _custom
                            	   194: waitvb	MACRO
                            	   195: 	IFEQ	NARG-1
                            	   196: .1\@		btst	#0,(vposr+1,\1)
                            	   197: 		beq	.1\@
                            	   198: .2\@		btst	#0,(vposr+1,\1)
                            	   199: 		bne	.2\@
                            	   200: 	ELSE
                            	   201: .1\@		btst	#0,(_custom+vposr+1)
                            	   202: 		beq	.1\@
                            	   203: .2\@		btst	#0,(_custom+vposr+1)
                            	   204: 		bne	.2\@
                            	   205: 	ENDC
                            	   206: 	ENDM
                            	   207: ***** this is the same as before but secure
                            	   208: ***** it also works when the code always run in only one half of
                            	   209: ***** the screen and therefore vertical bit pos 8 is unchanged
                            	   210: ***** (eg on programs with heavy interrupts or copper ints)
                            	   211: waitvbs	MACRO
                            	   212: 		movem.l	d0-d2,-(a7)
                            	   213: 		bsr	.g\@
                            	   214: .1\@		move.w	d0,d2
                            	   215: 		bsr	.g\@
                            	   216: 		cmp.w	d0,d2
                            	   217: 		bls	.1\@
                            	   218: 		bra	.q\@
                            	   219: 	IFEQ	NARG-1
                            	   220: .g\@		move.w	(vposr,\1),d0
                            	   221: 		move.b	(vhposr,\1),d1
                            	   222: 		cmp.w	(vposr,\1),d0
                            	   223: 	ELSE
                            	   224: .g\@		move.w	(_custom+vposr),d0
                            	   225: 		move.b	(_custom+vhposr),d1
                            	   226: 		cmp.w	(_custom+vposr),d0
                            	   227: 	ENDC
                            	   228: 		bne	.g\@
                            	   229: 		and.w	#1,d0
                            	   230: 		lsl.w	#8,d0
                            	   231: 		move.b	d1,d0
                            	   232: 		rts
                            	   233: .q\@		movem.l	(a7)+,d0-d2
                            	   234: 	ENDM
                            	   235: 
                            	   236: ****************************************************************
                            	   237: ***** wait for pressing any button
                            	   238: ***** better is using resload_Delay for this
                            	   239: ***** if \1 is given it must be an address register containing _custom
                            	   240: waitbutton	MACRO
                            	   241: 	IFEQ	NARG
                            	   242: 		move.l	a0,-(a7)
                            	   243: 		lea	(_custom),a0
                            	   244: .down\@		bsr	.wait\@
                            	   245: 		btst	#CIAB_GAMEPORT0,(ciapra+_ciaa)		;LMB
                            	   246: 		beq	.up\@
                            	   247: 		btst	#POTGOB_DATLY-8,(potinp,a0)		;RMB
                            	   248: 		beq	.up\@
                            	   249: 		btst	#CIAB_GAMEPORT1,(ciapra+_ciaa)		;FIRE
                            	   250: 		bne	.down\@
                            	   251: .up\@		bsr	.wait\@					;entprellen
                            	   252: 		btst	#CIAB_GAMEPORT0,(ciapra+_ciaa)		;LMB
                            	   253: 		beq	.up\@
                            	   254: 		btst	#POTGOB_DATLY-8,(potinp,a0)		;RMB
                            	   255: 		beq	.up\@
                            	   256: 		btst	#CIAB_GAMEPORT1,(ciapra+_ciaa)		;FIRE
                            	   257: 		beq	.up\@
                            	   258: 		bsr	.wait\@					;entprellen
                            	   259: 		bra	.done\@
                            	   260: .wait\@		waitvb	a0
                            	   261: 		rts
                            	   262: .done\@		move.l	(a7)+,a0
                            	   263: 	ELSE
                            	   264: 	IFEQ	NARG-1
                            	   265: .down\@		bsr	.wait\@
                            	   266: 		btst	#CIAB_GAMEPORT0,(ciapra+_ciaa)		;LMB
                            	   267: 		beq	.up\@
                            	   268: 		btst	#POTGOB_DATLY-8,(potinp,\1)		;RMB
                            	   269: 		beq	.up\@
                            	   270: 		btst	#CIAB_GAMEPORT1,(ciapra+_ciaa)		;FIRE
                            	   271: 		bne	.down\@
                            	   272: .up\@		bsr	.wait\@					;entprellen
                            	   273: 		btst	#CIAB_GAMEPORT0,(ciapra+_ciaa)		;LMB
                            	   274: 		beq	.up\@
                            	   275: 		btst	#POTGOB_DATLY-8,(potinp,\1)		;RMB
                            	   276: 		beq	.up\@
                            	   277: 		btst	#CIAB_GAMEPORT1,(ciapra+_ciaa)		;FIRE
                            	   278: 		beq	.up\@
                            	   279: 		bsr	.wait\@					;entprellen
                            	   280: 		bra	.done\@
                            	   281: .wait\@		waitvb	\1
                            	   282: 		rts
                            	   283: .done\@
                            	   284: 	ELSE
                            	   285: 		FAIL	"waitbutton: wrong amount of arguments"
                            	   286: 	ENDC
                            	   287: 	ENDC
                            	   288: 	ENDM
                            	   289: 
                            	   290: waitbuttonup	MACRO
                            	   291: 	IFEQ	NARG
                            	   292: 		move.l	a0,-(a7)
                            	   293: 		lea	(_custom),a0
                            	   294: .up\@		bsr	.wait\@					;entprellen
                            	   295: 		btst	#CIAB_GAMEPORT0,(ciapra+_ciaa)		;LMB
                            	   296: 		beq	.up\@
                            	   297: 		btst	#POTGOB_DATLY-8,(potinp,a0)		;RMB
                            	   298: 		beq	.up\@
                            	   299: 		btst	#CIAB_GAMEPORT1,(ciapra+_ciaa)		;FIRE
                            	   300: 		beq	.up\@
                            	   301: 		bsr	.wait\@					;entprellen
                            	   302: 		bra	.done\@
                            	   303: .wait\@		waitvb	a0
                            	   304: 		rts
                            	   305: .done\@		move.l	(a7)+,a0
                            	   306: 	ELSE
                            	   307: 	IFEQ	NARG-1
                            	   308: .up\@		waitvb	\1					;entprellen
                            	   309: 		btst	#CIAB_GAMEPORT0,(ciapra+_ciaa)		;LMB
                            	   310: 		beq	.up\@
                            	   311: 		btst	#POTGOB_DATLY-8,(potinp,\1)		;RMB
                            	   312: 		beq	.up\@
                            	   313: 		btst	#CIAB_GAMEPORT1,(ciapra+_ciaa)		;FIRE
                            	   314: 		beq	.up\@
                            	   315: 		waitvb	\1					;entprellen
                            	   316: 	ELSE
                            	   317: 		FAIL	"waitbuttonup: wrong amount of arguments"
                            	   318: 	ENDC
                            	   319: 	ENDC
                            	   320: 	ENDM
                            	   321: 
                            	   322: ****************************************************************
                            	   323: ***** flash the screen and wait for LMB
                            	   324: blitz		MACRO
                            	   325: 		move.l	d0,-(a7)
                            	   326: 	;	move	#DMAF_SETCLR!DMAF_RASTER,(_custom+dmacon)
                            	   327: .lpbl\@
                            	   328: 	IFNE NARG&1
                            	   329: 		move	#$4200,(_custom+bplcon0)
                            	   330: 	ENDC
                            	   331: 		move.w	d0,(_custom+color)
                            	   332: 		subq.w	#1,d0
                            	   333: 		btst	#6,$bfe001
                            	   334: 		bne	.lpbl\@
                            	   335: 		bsr	.waitvb\@			;entprellen
                            	   336: 		bsr	.waitvb\@			;entprellen
                            	   337: .lp2bl\@
                            	   338: 	IFNE NARG&1
                            	   339: 		move	#$4200,(_custom+bplcon0)
                            	   340: 	ENDC
                            	   341: 		move.w	d0,(_custom+color)
                            	   342: 		subq.w	#1,d0
                            	   343: 		btst	#6,$bfe001
                            	   344: 		beq	.lp2bl\@
                            	   345: 		bsr	.waitvb\@			;entprellen
                            	   346: 		bsr	.waitvb\@			;entprellen
                            	   347: 		clr.w	(_custom+color)
                            	   348: 		move.l	(a7)+,d0
                            	   349: 		bra	.end\@
                            	   350: .waitvb\@	waitvb
                            	   351: 		rts
                            	   352: .end\@
                            	   353: 		ENDM
                            	   354: 
                            	   355: ****************************************************************
                            	   356: ***** color the screen and wait for LMB
                            	   357: bwait		MACRO
                            	   358: 		move	#$1200,bplcon0+_custom
                            	   359: .wd\@
                            	   360: 	IFEQ NARG
                            	   361: 		move.w	#$ff0,color+_custom		;yellow
                            	   362: 	ELSE
                            	   363: 		move.w	#\1,color+_custom
                            	   364: 	ENDC
                            	   365: 		btst	#6,$bfe001
                            	   366: 		bne	.wd\@
                            	   367: 		waitvb					;entprellen
                            	   368: 		waitvb					;entprellen
                            	   369: .wu\@		btst	#6,$bfe001
                            	   370: 		beq	.wu\@
                            	   371: 		waitvb					;entprellen
                            	   372: 		waitvb					;entprellen
                            	   373: 		clr.w	color+_custom
                            	   374: 		ENDM
                            	   375: 
                            	   376: ****************************************************************
                            	   377: ***** install Vertical-Blank-Interrupt which quits on LMB pressed
                            	   378: QUITVBI		MACRO
                            	   379: 		move.l	a0,-(a7)
                            	   380: 		lea	(.vbi,pc),a0
                            	   381: 		move.l	a0,$6c
                            	   382: 		bra	.g
                            	   383: .vbi		btst	#6,$bfe001
                            	   384: 		beq	.vbi+1		;create "address error"
                            	   385: 		move.w	#INTF_VERTB,_custom+intreq
                            	   386: 		rte
                            	   387: .g		move.w	#INTF_SETCLR!INTF_INTEN!INTF_VERTB,_custom+intena
                            	   388: 		move.w	#INTF_VERTB,_custom+intreq
                            	   389: 		move.l	(a7)+,a0
                            	   390: 	ENDM
                            	   391: 
                            	   392: ****************************************************************
                            	   393: ***** set all registers to zero
                            	   394: resetregs	MACRO
                            	   395: 		moveq	#0,d0
                            	   396: 		moveq	#0,d1
                            	   397: 		moveq	#0,d2
                            	   398: 		moveq	#0,d3
                            	   399: 		moveq	#0,d4
                            	   400: 		moveq	#0,d5
                            	   401: 		moveq	#0,d6
                            	   402: 		moveq	#0,d7
                            	   403: 		sub.l	a0,a0
                            	   404: 		sub.l	a1,a1
                            	   405: 		sub.l	a2,a2
                            	   406: 		sub.l	a3,a3
                            	   407: 		sub.l	a4,a4
                            	   408: 		sub.l	a5,a5
                            	   409: 		sub.l	a6,a6
                            	   410: 	ENDM
                            	   411: 
                            	   412: ****************************************************************
                            	   413: ***** create message in .whdl_log
                            	   414: ***** requires WHDLoad version 18 and active option FileLog/S
                            	   415: ***** label _resload must contain Resload base
                            	   416: ***** all arguments must be long
                            	   417: ***** all registers are preserved
                            	   418: ***** this macro only works with vasm!
                            	   419: ***** LOG <"text %s d0=%lx d1=%ld">,d0,d1
                            	   420: 
                            	   421: LOG MACRO
                            	   422: 		move.l	a0,-(a7)	; don't use movem to preserve _MOVEMREGS/BYTES
                            	   423: 		move.l	a1,-(a7)
                            	   424: 		move.l	a2,-(a7)
                            	   425: CARG SET \#
                            	   426: 	REPT \#-1
                            	   427: 		move.l	\-,-(a7)
                            	   428: 	ENDR
                            	   429: 		bra	.skip\@
                            	   430: .fmt\@		db	\1,0
                            	   431: 	EVEN
                            	   432: .skip\@		lea	(.fmt\@),a0
                            	   433: 		move.l	a7,a1
                            	   434: 		move.l	(_resload,pc),a2
                            	   435: 		jsr	(resload_Log,a2)
                            	   436: 
                            	   437: 		add	#(\#-1)*4,a7
                            	   438: 		move.l	(a7)+,a2
                            	   439: 		move.l	(a7)+,a1
                            	   440: 		move.l	(a7)+,a0
                            	   441: 	ENDM
                            	   442: 
                            	   443: ;=============================================================================
                            	   444: 
                            	   445:  ENDC
                            	   446: 
                            	   447: 

Source: "SWOSHD.s"
                            	    15: 
                            	    16:     IFD    BARFLY
                            	    17: 	OUTPUT	wdh1:SWOS2/SWOS.Slave
                            	    18: 	;OPT	O+ OG+			;enable optimizing
                            	    19:     ENDC
                            	    20: 
                            	    21: BUFFER_SIZE = $800
                            	    22: 
                            	    23: PROGRAM_LOCATION_OFFSET = $80000
                            	    24: 
                            	    25: CHIPMEMSIZE = $200000
                            	    26: FASTMEMSIZE = $200000
                            	    27: 
                            	    28: STUB_FIX_SNOOP_BUG      = $0006
                            	    29: STUB_FIX_MEM            = $000E
                            	    30: STUB_ROB_NORTHEN_LOADER = $0016
                            	    31: STUB_ACCESS             = $001E
                            	    32: STUB_KB_HOOK            = $0026
                            	    33: 
                            	    34: ; 1MB chip + 1,5MB slow mem prog @ $D00000
                            	    35: ; D5 07000000: fastmem: 07 = 0111 = 1.5MB
                            	    36: ; D6 07000003: chipmem: 03 = 0011 = 1MB
                            	    37: ; D7 00280000 : total memory
                            	    38: 
                            	    39: ; chip 2MB: prog @ $180000
                            	    40: ; D5 00000000: no fastmem
                            	    41: ; D6 0000000F: chipmem: 1111 = 2MB         
                            	    42: ; D7 00200000: total memory
                            	    43: 
                            	    44: ; autocompute bit masks (not very useful, as the memory routine
                            	    45: ; is so obscure and buggy that it is completely skipped)
                            	    46: CHIPBITS = (1<<(CHIPMEMSIZE/$80000))-1
                            	    47: FASTBITS = ((1<<(FASTMEMSIZE/$80000))-1)<<24
                            	    48:     
