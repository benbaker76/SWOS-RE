                            	    61: 	BITDEF	BM,RTGCHECK,9
                            	     1M 	    BITDEF0 BM,RTGCHECK,B_,9
                            	     1M BMB_RTGCHECK	    EQU     9
                            	     2M _000287BITDEF    SET     1<<9
                            	     3M 	    BITDEF0 BM,RTGCHECK,F_,_000287BITDEF
                            	     1M BMF_RTGCHECK	    EQU     _000287BITDEF
                            	    62: 	BITDEF	BM,FRIENDISTAG,10
                            	     1M 	    BITDEF0 BM,FRIENDISTAG,B_,10
                            	     1M BMB_FRIENDISTAG	    EQU     10
                            	     2M _000290BITDEF    SET     1<<10
                            	     3M 	    BITDEF0 BM,FRIENDISTAG,F_,_000290BITDEF
                            	     1M BMF_FRIENDISTAG	    EQU     _000290BITDEF
                            	    63: 	BITDEF	BM,INVALID,11
