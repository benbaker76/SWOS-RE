                            	     2M SOFFSET     SET     SOFFSET+2
                            	   102: 	UWORD	dim_MinRasterHeight	; minimum height in pixels
                            	     1M dim_MinRasterHeight	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	   103: 	UWORD	dim_MaxRasterWidth	; maximum width in pixels
                            	     1M dim_MaxRasterWidth	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	   104: 	UWORD	dim_MaxRasterHeight	; maximum height in pixels
                            	     1M dim_MaxRasterHeight	    EQU     SOFFSET
