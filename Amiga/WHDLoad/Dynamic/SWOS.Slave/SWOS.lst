                            	   311: ;=============================================================================
                            	   312: ; properties for resload_SetCPU
                            	   313: ;=============================================================================
                            	   314: 
                            	   315: WCPUF_Base	= 3		;BaseMem mask
                            	   316: WCPUF_Base_NCS	= 0		;BaseMem = non cacheable serialized
                            	   317: WCPUF_Base_NC	= 1		;BaseMem = non cacheable
                            	   318: WCPUF_Base_WT	= 2		;BaseMem = cacheable write through
                            	   319: WCPUF_Base_CB	= 3		;BaseMem = cacheable copyback
                            	   320: WCPUF_Exp	= 12		;ExpMem mask
                            	   321: WCPUF_Exp_NCS	= 0		;ExpMem = non cacheable serialized
                            	   322: WCPUF_Exp_NC	= 4		;ExpMem = non cacheable
                            	   323: WCPUF_Exp_WT	= 8		;ExpMem = cacheable write through
                            	   324: WCPUF_Exp_CB	= 12		;ExpMem = cacheable copyback
                            	   325: WCPUF_Slave	= 48		;Slave mask
                            	   326: WCPUF_Slave_NCS	= 0		;Slave = non cacheable serialized
                            	   327: WCPUF_Slave_NC	= 16		;Slave = non cacheable
                            	   328: WCPUF_Slave_WT	= 32		;Slave = cacheable write through
                            	   329: WCPUF_Slave_CB	= 48		;Slave = cacheable copyback
                            	   330: 
                            	   331: 	BITDEF WCPU,IC,8	;instruction cache (20-60)
                            	     1M 	    BITDEF0 WCPU,IC,B_,8
                            	     1M WCPUB_IC	    EQU     8
                            	     2M _000485BITDEF    SET     1<<8
                            	     3M 	    BITDEF0 WCPU,IC,F_,_000485BITDEF
                            	     1M WCPUF_IC	    EQU     _000485BITDEF
                            	   332: 	BITDEF WCPU,DC,9	;data cache (30-60)
                            	     1M 	    BITDEF0 WCPU,DC,B_,9
                            	     1M WCPUB_DC	    EQU     9
                            	     2M _000488BITDEF    SET     1<<9
                            	     3M 	    BITDEF0 WCPU,DC,F_,_000488BITDEF
                            	     1M WCPUF_DC	    EQU     _000488BITDEF
                            	   333: 	BITDEF WCPU,NWA,10	;disable write allocation (30)
                            	     1M 	    BITDEF0 WCPU,NWA,B_,10
                            	     1M WCPUB_NWA	    EQU     10
                            	     2M _000491BITDEF    SET     1<<10
                            	     3M 	    BITDEF0 WCPU,NWA,F_,_000491BITDEF
                            	     1M WCPUF_NWA	    EQU     _000491BITDEF
                            	   334: 	BITDEF WCPU,SB,11	;store buffer (60)
                            	     1M 	    BITDEF0 WCPU,SB,B_,11
                            	     1M WCPUB_SB	    EQU     11
                            	     2M _000494BITDEF    SET     1<<11
                            	     3M 	    BITDEF0 WCPU,SB,F_,_000494BITDEF
                            	     1M WCPUF_SB	    EQU     _000494BITDEF
                            	   335: 	BITDEF WCPU,BC,12	;branch cache (60)
                            	     1M 	    BITDEF0 WCPU,BC,B_,12
                            	     1M WCPUB_BC	    EQU     12
                            	     2M _000497BITDEF    SET     1<<12
                            	     3M 	    BITDEF0 WCPU,BC,F_,_000497BITDEF
                            	     1M WCPUF_BC	    EQU     _000497BITDEF
                            	   336: 	BITDEF WCPU,SS,13	;superscalar dispatch (60)
                            	     1M 	    BITDEF0 WCPU,SS,B_,13
                            	     1M WCPUB_SS	    EQU     13
                            	     2M _000500BITDEF    SET     1<<13
                            	     3M 	    BITDEF0 WCPU,SS,F_,_000500BITDEF
                            	     1M WCPUF_SS	    EQU     _000500BITDEF
                            	   337: 	BITDEF WCPU,FPU,14	;enable fpu (60)
                            	     1M 	    BITDEF0 WCPU,FPU,B_,14
                            	     1M WCPUB_FPU	    EQU     14
                            	     2M _000503BITDEF    SET     1<<14
                            	     3M 	    BITDEF0 WCPU,FPU,F_,_000503BITDEF
                            	     1M WCPUF_FPU	    EQU     _000503BITDEF
                            	   338: 
                            	   339: WCPUF_All	= WCPUF_Base!WCPUF_Exp!WCPUF_Slave!WCPUF_IC!WCPUF_DC!WCPUF_NWA!WCPUF_SB!WCPUF_BC!WCPUF_SS!WCPUF_FPU
