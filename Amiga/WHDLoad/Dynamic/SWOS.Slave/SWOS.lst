                            	    64: 
                            	    65: 	;; if the flags AND checkmask equals CHECKVALUE
                            	    66: 	;; then the "friend" pointer is actually a tag list
                            	    67: BMF_CHECKMASK	equ	BMF_HIJACKED+BMF_RTGTAGS+BMF_RTGCHECK+BMF_FRIENDISTAG+BMF_INVALID
                            	    68: BMF_CHECKVALUE  equ	BMF_RTGTAGS+BMF_RTGCHECK+BMF_FRIENDISTAG
                            	    69: 
                            	    70: 	;; flags for GetBitMapAttr()
                            	    71: BMA_HEIGHT	equ	0
                            	    72: BMA_DEPTH	equ	4
                            	    73: BMA_WIDTH	equ	8
                            	    74: BMA_FLAGS	equ	12
                            	    75: 
                            	    76: 	;; tags for AllocBitMap
                            	    77: 
                            	    78: BMATags_Friend		equ	TAG_USER+0 ;specify a friend bitmap by tags. Default is no friend
                            	    79: BMATags_Depth		equ	TAG_USER+1 ;depth of the bitmap. Default is the depth parameter
                            	    80: BMATags_PixelFormat	equ	TAG_USER+2 ;pixel format for RTG graphics. Ignored by graphics.
                            	    81: BMATags_Clear		equ	TAG_USER+3 ;clear the bitmap? Default is taken from the BMF_Clear flag.
                            	    82: BMATags_Displayable 	equ	TAG_USER+4 ;used for loading onto graphics hardware for display? Default is from flag.
                            	    83: BMATags_Private1 	equ	TAG_USER+5 ;internal use only
                            	    84: BMATags_NoMemory	equ	TAG_USER+6 ;only allocate the bitmap structure, no memory. Ignored by graphics.
                            	    85: BMATags_NoSprite        equ	TAG_USER+7 ;disable hardware sprites. Ignored by graphics.
                            	    86: BMATags_Private2	equ	TAG_USER+8 ;internal use only
                            	    87: BMATags_Private3	equ	TAG_USER+9 ;internal use only
                            	    88: BMATags_ModeWidth  	equ	TAG_USER+10 ;width of the visible area. Default is from DisplayInfoDB. Ignored by Gfx.
                            	    89: BMATags_ModeHeight 	equ	TAG_USER+11 ;height of the visible area. Default is from DisplayInfoDB. Ignored by Gfx.
                            	    90: BMATags_RenderFunc	equ	TAG_USER+12 ;private use only
                            	    91: BMATags_SaveFunc	equ	TAG_USER+13 ;private use only
                            	    92: BMATags_UserData	equ	TAG_USER+14 ;private use only
                            	    93: BMATags_Alignment	equ	TAG_USER+15 ;alignment of rows (powers of two). Igored by Gfx.
                            	    94: BMATags_ConstantBytesPerRow equ	TAG_USER+16 ;enforce alignment for displayable bitmaps. Ignored by Gfx.
                            	    95: BMATags_UserPrivate	equ	TAG_USER+17 ;bitmap will never be loaded into video RAM. Ignored by Gfx.
                            	    96: BMATags_Private4	equ	TAG_USER+18 ;internal use only
                            	    97: BMATags_Private5	equ	TAG_USER+19 ;internal use only
                            	    98: BMATags_Private6	equ	TAG_USER+20 ;internal use only
                            	    99: BMATags_Private7	equ	TAG_USER+21 ;internal use only
                            	   100: BMATags_DisplayID	equ	TAG_USER+$32 ;a display ID from the monitor data base for which to allocate the bitmap
                            	   101: 	;; this is intentionally identical to SA_DisplayID from intuition/intuition.i
                            	   102: BMATags_BitmapInvisible	equ	TAG_USER+$37 ;bitmap is not initially visible
                            	   103: 	;; intentionally identical to SA_Behind from intuition/intuition.i
                            	   104: BMATags_BitmapColors	equ	TAG_USER+$29 ;ptr to an array of struct ColorSpec, terminated by -1
                            	   105: 	;; this defines an initial palette. intentionally identical to SA_Colors, ignored by Gfx
                            	   106: BMATags_BitmapColors32	equ	TAG_USER+$43 ;ptr to 32-bits-per-gun color, passed over to LoadRGB32
                            	   107: 	;; this also defines an initial palette in an alternative way, ignored by Gfx
                            	   108: 	;; this tag is intentionally identical to SA_Colors32
