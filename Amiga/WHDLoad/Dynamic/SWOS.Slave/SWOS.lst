                            	    99:     STRUCTURE DimensionInfo,qh_SIZEOF
                            	     1M DimensionInfo	    EQU     0
                            	     2M SOFFSET     SET     qh_SIZEOF
                            	   100: 	UWORD	dim_MaxDepth		; log2( max number of colors
                            	     1M dim_MaxDepth	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	   101: 	UWORD	dim_MinRasterWidth	; minimum width in pixels
