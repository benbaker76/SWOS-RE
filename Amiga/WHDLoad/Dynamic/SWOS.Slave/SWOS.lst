                            	    82: DIPF_IS_DRAGGABLE		equ	$00000200
                            	    83: DIPF_IS_PANELLED		equ	$00000400
                            	    84: DIPF_IS_BEAMSYNC		equ	$00000800
                            	    85: DIPF_IS_EXTRAHALFBRITE		equ	$00001000
                            	    86: 
                            	    87: ; The following DIPF_IS_... flags are new for V39
                            	    88: DIPF_IS_SPRITES_ATT		equ	$00002000	; supports attached sprites
                            	    89: DIPF_IS_SPRITES_CHNG_RES	equ	$00004000	; supports variable sprite resolution
                            	    90: DIPF_IS_SPRITES_BORDER		equ	$00008000	; sprites can be displayed in borders
                            	    91: DIPF_IS_SCANDBL			equ	$00020000	; scan-doubled?
                            	    92: DIPF_IS_SPRITES_CHNG_BASE	equ	$00040000	; can change the sprite base color
                            	    93: DIPF_IS_SPRITES_CHNG_PRI	equ	$00080000	; can change sprite priority
                            	    94: DIPF_IS_DBUFFER			equ	$00100000	; can support double buffering
                            	    95: DIPF_IS_PROGBEAM		equ	$00200000	; programmed beam-sync mode
                            	    96: DIPF_IS_FOREIGN			equ	$80000000	; non-amiga mode?
