                            	    52: 	;; flags for AllocBitMap
                            	    53: 	BITDEF  BM,CLEAR,0
                            	     1M 	    BITDEF0 BM,CLEAR,B_,0
                            	     1M BMB_CLEAR	    EQU     0
                            	     2M _000266BITDEF    SET     1<<0
                            	     3M 	    BITDEF0 BM,CLEAR,F_,_000266BITDEF
                            	     1M BMF_CLEAR	    EQU     _000266BITDEF
                            	    54: 	BITDEF  BM,DISPLAYABLE,1
                            	     1M 	    BITDEF0 BM,DISPLAYABLE,B_,1
                            	     1M BMB_DISPLAYABLE	    EQU     1
                            	     2M _000269BITDEF    SET     1<<1
                            	     3M 	    BITDEF0 BM,DISPLAYABLE,F_,_000269BITDEF
                            	     1M BMF_DISPLAYABLE	    EQU     _000269BITDEF
                            	    55: 	BITDEF	BM,INTERLEAVED,2
                            	     1M 	    BITDEF0 BM,INTERLEAVED,B_,2
                            	     1M BMB_INTERLEAVED	    EQU     2
                            	     2M _000272BITDEF    SET     1<<2
                            	     3M 	    BITDEF0 BM,INTERLEAVED,F_,_000272BITDEF
                            	     1M BMF_INTERLEAVED	    EQU     _000272BITDEF
                            	    56: 	BITDEF	BM,STANDARD,3
                            	     1M 	    BITDEF0 BM,STANDARD,B_,3
                            	     1M BMB_STANDARD	    EQU     3
                            	     2M _000275BITDEF    SET     1<<3
                            	     3M 	    BITDEF0 BM,STANDARD,F_,_000275BITDEF
                            	     1M BMF_STANDARD	    EQU     _000275BITDEF
                            	    57: 	BITDEF	BM,MINPLANES,4
                            	     1M 	    BITDEF0 BM,MINPLANES,B_,4
                            	     1M BMB_MINPLANES	    EQU     4
                            	     2M _000278BITDEF    SET     1<<4
                            	     3M 	    BITDEF0 BM,MINPLANES,F_,_000278BITDEF
                            	     1M BMF_MINPLANES	    EQU     _000278BITDEF
                            	    58: 	;; the following are new in V45
                            	    59: 	BITDEF	BM,HIJACKED,7
                            	     1M 	    BITDEF0 BM,HIJACKED,B_,7
                            	     1M BMB_HIJACKED	    EQU     7
                            	     2M _000281BITDEF    SET     1<<7
                            	     3M 	    BITDEF0 BM,HIJACKED,F_,_000281BITDEF
                            	     1M BMF_HIJACKED	    EQU     _000281BITDEF
                            	    60: 	BITDEF	BM,RTGTAGS,8
                            	     1M 	    BITDEF0 BM,RTGTAGS,B_,8
                            	     1M BMB_RTGTAGS	    EQU     8
                            	     2M _000284BITDEF    SET     1<<8
                            	     3M 	    BITDEF0 BM,RTGTAGS,F_,_000284BITDEF
