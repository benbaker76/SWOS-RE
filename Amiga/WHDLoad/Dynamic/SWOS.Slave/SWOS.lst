                            	   341: ;=============================================================================
                            	   342: ; resload_#? functions
                            	   343: ; a JMP-tower inside WHDLoad (similar to a library)
                            	   344: ; base is given on startup via A0
                            	   345: ;=============================================================================
                            	   346: 
                            	   347:     STRUCTURE	ResidentLoader,0
                            	     1M ResidentLoader	    EQU     0
                            	     2M SOFFSET     SET     0
                            	   348: 	ULONG	resload_Install		;private
                            	     1M resload_Install	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   349: 	ULONG	resload_Abort
                            	     1M resload_Abort	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   350: 		; return to operating system (4)
                            	   351: 		; IN: (a7) = ULONG  reason for aborting
                            	   352: 		;   (4,a7) = ULONG  primary error code
                            	   353: 		;   (8,a7) = ULONG  secondary error code
                            	   354: 		; ATTENTION: this routine must be called via JMP (not JSR)
                            	   355: 	ULONG	resload_LoadFile
                            	     1M resload_LoadFile	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   356: 		; load file to memory (8)
                            	   357: 		; IN:	a0 = CSTR   filename
                            	   358: 		;	a1 = APTR   address
                            	   359: 		; OUT:	d0 = ULONG  success (size of file)
                            	   360: 		;	d1 = ULONG  dos errorcode
                            	   361: 	ULONG	resload_SaveFile
                            	     1M resload_SaveFile	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   362: 		; write memory to file (c)
                            	   363: 		; IN:	d0 = ULONG  size
                            	   364: 		;	a0 = CSTR   filename
                            	   365: 		;	a1 = APTR   address
                            	   366: 		; OUT:	d0 = BOOL   success
                            	   367: 		;	d1 = ULONG  dos errorcode
                            	   368: 	ULONG	resload_SetCACR
                            	     1M resload_SetCACR	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   369: 		; set cachebility for BaseMem (10)
                            	   370: 		; IN:	d0 = ULONG  new setup
                            	   371: 		;	d1 = ULONG  mask
                            	   372: 		; OUT:	d0 = ULONG  old setup
                            	   373: 	ULONG	resload_ListFiles
                            	     1M resload_ListFiles	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   374: 		; list filenames of a directory (14)
                            	   375: 		; IN:	d0 = ULONG  buffer size
                            	   376: 		;	a0 = CSTR   name of directory to scan
                            	   377: 		;	a1 = APTR   buffer (must be located inside Slave,
                            	   378: 		;	with WHDLoad 16.8+ also inside ExpMem)
                            	   379: 		; OUT:	d0 = ULONG  amount of names in buffer filled
                            	   380: 		;	d1 = ULONG  dos errorcode
                            	   381: 	ULONG	resload_Decrunch
                            	     1M resload_Decrunch	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   382: 		; uncompress data in memory (18)
                            	   383: 		; IN:	a0 = APTR   source
                            	   384: 		;	a1 = APTR   destination (can be equal to source)
                            	   385: 		; OUT:	d0 = ULONG  uncompressed size
                            	   386: 	ULONG	resload_LoadFileDecrunch
                            	     1M resload_LoadFileDecrunch	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   387: 		; load file and uncompress it (1c)
                            	   388: 		; IN:	a0 = CSTR   filename
                            	   389: 		;	a1 = APTR   address
                            	   390: 		; OUT:	d0 = ULONG  success (size of file uncompressed)
                            	   391: 		;	d1 = ULONG  dos errorcode
                            	   392: 	ULONG	resload_FlushCache
                            	     1M resload_FlushCache	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   393: 		; clear CPU caches (20)
                            	   394: 		; IN:	-
                            	   395: 		; OUT:	-
                            	   396: 	ULONG	resload_GetFileSize
                            	     1M resload_GetFileSize	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   397: 		; get size of a file (24)
                            	   398: 		; IN:	a0 = CSTR   filename
                            	   399: 		; OUT:	d0 = ULONG  size of file
                            	   400: 	ULONG	resload_DiskLoad
                            	     1M resload_DiskLoad	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   401: 		; load part from disk image (28)
                            	   402: 		; IN:	d0 = ULONG  offset
                            	   403: 		;	d1 = ULONG  size
                            	   404: 		;	d2 = ULONG  disk number
                            	   405: 		;	a0 = APTR   destination
                            	   406: 		; OUT:	d0 = BOOL   success
                            	   407: 		;	d1 = ULONG  dos errorcode
                            	   408: 
                            	   409: ******* the following functions require ws_Version >= 2
                            	   410: 
                            	   411: 	ULONG	resload_DiskLoadDev
                            	     1M resload_DiskLoadDev	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   412: 		; load part from physical disk via trackdisk (2c)
                            	   413: 		; IN:	d0 = ULONG  offset
                            	   414: 		;	d1 = ULONG  size
                            	   415: 		;	a0 = APTR   destination
                            	   416: 		;	a1 = STRUCT taglist
                            	   417: 		; OUT:	d0 = BOOL   success
                            	   418: 		;	d1 = ULONG  trackdisk errorcode
                            	   419: 
                            	   420: ******* the following functions require ws_Version >= 3
                            	   421: 
                            	   422: 	ULONG	resload_CRC16
                            	     1M resload_CRC16	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   423: 		; calculate 16 bit CRC checksum (30)
                            	   424: 		; IN:	d0 = ULONG  size
                            	   425: 		;	a0 = APTR   address
                            	   426: 		; OUT:	d0 = UWORD  CRC checksum
                            	   427: 
                            	   428: ******* the following functions require ws_Version >= 5
                            	   429: 
                            	   430: 	ULONG	resload_Control
                            	     1M resload_Control	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   431: 		; misc control, get/set variables (34)
                            	   432: 		; IN:	a0 = STRUCT taglist
                            	   433: 		; OUT:	d0 = BOOL   success
                            	   434: 	ULONG	resload_SaveFileOffset
                            	     1M resload_SaveFileOffset	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   435: 		; write memory to file at offset (38)
                            	   436: 		; IN:	d0 = ULONG  size
                            	   437: 		;	d1 = ULONG  offset
                            	   438: 		;	a0 = CSTR   filename
                            	   439: 		;	a1 = APTR   address
                            	   440: 		; OUT:	d0 = BOOL   success
                            	   441: 		;	d1 = ULONG  dos errcode
                            	   442: 
                            	   443: ******* the following functions require ws_Version >= 6
                            	   444: 
                            	   445: 	ULONG	resload_ProtectRead
                            	     1M resload_ProtectRead	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   446: 		; mark memory as read protected (3c)
                            	   447: 		; IN:	d0 = ULONG  length
                            	   448: 		;	a0 = APTR   address
                            	   449: 		; OUT:	-
                            	   450: 	ULONG	resload_ProtectReadWrite
                            	     1M resload_ProtectReadWrite	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   451: 		; mark memory as read and write protected (40)
                            	   452: 		; IN:	d0 = ULONG  length
                            	   453: 		;	a0 = APTR   address
                            	   454: 		; OUT:	-
                            	   455: 	ULONG	resload_ProtectWrite
                            	     1M resload_ProtectWrite	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   456: 		; mark memory as write protected (44)
                            	   457: 		; IN:	d0 = ULONG  length
                            	   458: 		;	a0 = APTR   address
                            	   459: 		; OUT:	-
                            	   460: 	ULONG	resload_ProtectRemove
                            	     1M resload_ProtectRemove	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   461: 		; remove memory protection (48)
                            	   462: 		; IN:	d0 = ULONG  length
                            	   463: 		;	a0 = APTR   address
                            	   464: 		; OUT:	-
                            	   465: 	ULONG	resload_LoadFileOffset
                            	     1M resload_LoadFileOffset	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   466: 		; load part of file to memory (4c)
                            	   467: 		; IN:	d0 = ULONG  size
                            	   468: 		;	d1 = ULONG  offset
                            	   469: 		;	a0 = CSTR   filename
                            	   470: 		;	a1 = APTR   destination
                            	   471: 		; OUT:	d0 = BOOL   success
                            	   472: 		;	d1 = ULONG  dos errorcode
                            	   473: 
                            	   474: ******* the following functions require ws_Version >= 8
                            	   475: 
                            	   476: 	ULONG	resload_Relocate
                            	     1M resload_Relocate	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   477: 		; relocate AmigaDOS executable (50)
                            	   478: 		; IN:	a0 = APTR   address (source=destination)
                            	   479: 		;	a1 = STRUCT taglist
                            	   480: 		; OUT:	d0 = ULONG  size
                            	   481: 	ULONG	resload_Delay
                            	     1M resload_Delay	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   482: 		; wait some time or button pressed (54)
                            	   483: 		; IN:	d0 = ULONG  time to wait in 1/10 seconds
                            	   484: 		; OUT:	-
                            	   485: 	ULONG	resload_DeleteFile
                            	     1M resload_DeleteFile	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   486: 		; delete file (58)
                            	   487: 		; IN:	a0 = CSTR   filename
                            	   488: 		; OUT:	d0 = BOOL   success
                            	   489: 		;	d1 = ULONG  dos errorcode
                            	   490: 
                            	   491: ******* the following functions require ws_Version >= 10
                            	   492: 
                            	   493: 	ULONG	resload_ProtectSMC
                            	     1M resload_ProtectSMC	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   494: 		; detect self modifying code (5c)
                            	   495: 		; IN:	d0 = ULONG  length
                            	   496: 		;	a0 = APTR   address
                            	   497: 		; OUT:	-
                            	   498: 	ULONG	resload_SetCPU
                            	     1M resload_SetCPU	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   499: 		; control CPU setup (60)
                            	   500: 		; IN:	d0 = ULONG  properties, see above
                            	   501: 		;	d1 = ULONG  mask
                            	   502: 		; OUT:	d0 = ULONG  old properties
                            	   503: 	ULONG	resload_Patch
                            	     1M resload_Patch	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   504: 		; apply patchlist (64)
                            	   505: 		; IN:	a0 = APTR   patchlist, see below
                            	   506: 		;	a1 = APTR   destination address
                            	   507: 		; OUT:	-
                            	   508: 
                            	   509: ******* the following functions require ws_Version >= 11
                            	   510: 
                            	   511: 	ULONG	resload_LoadKick
                            	     1M resload_LoadKick	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   512: 		; load kickstart image (68)
                            	   513: 		; IN:	d0 = ULONG  length of image
                            	   514: 		;	d1 = UWORD  crc16 of image
                            	   515: 		;	a0 = CSTR   basename of image
                            	   516: 		; OUT:	-
                            	   517: 	ULONG	resload_Delta
                            	     1M resload_Delta	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   518: 		; apply WDelta data to modify memory (6c)
                            	   519: 		; IN:	a0 = APTR   src data
                            	   520: 		;	a1 = APTR   dest data
                            	   521: 		;	a2 = APTR   wdelta data
                            	   522: 		; OUT:	-
                            	   523: 	ULONG	resload_GetFileSizeDec
                            	     1M resload_GetFileSizeDec	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   524: 		; get size of a packed file (70)
                            	   525: 		; IN:	a0 = CSTR   filename
                            	   526: 		; OUT:	d0 = ULONG  size of file uncompressed
                            	   527: 
                            	   528: ******* the following functions require ws_Version >= 15
                            	   529: 
                            	   530: 	ULONG	resload_PatchSeg
                            	     1M resload_PatchSeg	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   531: 		; apply patchlist to a segment list (74)
                            	   532: 		; IN:	a0 = APTR   patchlist, see below
                            	   533: 		;	a1 = BPTR   segment list
                            	   534: 		; OUT:	-
                            	   535: 
                            	   536: 	ULONG	resload_Examine
                            	     1M resload_Examine	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   537: 		; examine a file or directory (78)
                            	   538: 		; IN:	a0 = CSTR   name
                            	   539: 		;	a1 = APTR   struct FileInfoBlock (260 bytes)
                            	   540: 		; OUT:	d0 = BOOL   success
                            	   541: 		;	d1 = ULONG  dos errorcode
                            	   542: 
                            	   543: 	ULONG	resload_ExNext
                            	     1M resload_ExNext	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   544: 		; examine next entry of a directory (7c)
                            	   545: 		; IN:	a0 = APTR   struct FileInfoBlock (260 bytes)
                            	   546: 		; OUT:	d0 = BOOL   success
                            	   547: 		;	d1 = ULONG  dos errorcode
                            	   548: 
                            	   549: 	ULONG	resload_GetCustom
                            	     1M resload_GetCustom	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   550: 		; get Custom argument (80)
                            	   551: 		; IN:	d0 = ULONG  length of buffer
                            	   552: 		;	d1 = ULONG  reserved, must be 0
                            	   553: 		;	a0 = APTR   buffer
                            	   554: 		; OUT:	d0 = BOOL   true if Custom has fit into buffer
                            	   555: 
                            	   556: ******* the following functions require ws_Version >= 18
                            	   557: 
                            	   558: 	ULONG	resload_VSNPrintF
                            	     1M resload_VSNPrintF	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   559: 		; format string like clib.vsnprintf/exec.RawDoFmt (84)
                            	   560: 		; IN:	d0 = ULONG  length of buffer
                            	   561: 		;	a0 = APTR   buffer to fill
                            	   562: 		;	a1 = CPTR   format string
                            	   563: 		;	a2 = APTR   argument array
                            	   564: 		; OUT:	d0 = ULONG  length of created string with unlimited
                            	   565: 		;		    buffer without final '\0'
                            	   566: 		;	a0 = APTR   pointer to final '\0'
                            	   567: 
                            	   568: 	ULONG	resload_Log
                            	     1M resload_Log	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   569: 		; write log message (88)
                            	   570: 		; IN:	a0 = CSTR   format string
                            	   571: 		;   (4,a7) = LABEL  argument array
                            	   572: 		; OUT:	-
                            	   573: 
                            	   574: ******* the following functions require ws_Version >= 19
                            	   575: 
                            	   576: 	ULONG	resload_ReadJoyPort
                            	     1M resload_ReadJoyPort	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	   577: 		; return the state of the selected joy/mouse port (8c)
                            	   578: 		; IN:	d0 = ULONG  port/flags
                            	   579: 		; OUT:	d0 = ULONG  state
                            	   580: 
                            	   581: 	LABEL	resload_SIZEOF
                            	     1M resload_SIZEOF	    EQU     SOFFSET
                            	   582: 
                            	   583: ******* compatibility for older slave sources:
                            	   584: 
                            	   585: resload_CheckFileExist = resload_GetFileSize
                            	   586: 
                            	   587: ;=============================================================================
                            	   588: ; commands used in patchlist
                            	   589: ; each command follows the address to modify, if bit #15 of the command is
                            	   590: ; cleared address follows as 32 bit, if bit #15 of the command is set it
                            	   591: ; follows as 16 bit (unsigned extended to 32 bit)
                            	   592: ; the following arguments differ for the various commands
                            	   593: ; control commands (END, IF*, ELSE, ENDIF) does not follow an address, on 
                            	   594: ; these commands (except END) bit #14 is set to indicate them
                            	   595: ; see autodoc file whdload.doc for enhanced documentation and examples
                            	   596: 
                            	   597:  BITDEF PLCMD,WORDADR,15
                            	     1M 	    BITDEF0 PLCMD,WORDADR,B_,15
                            	     1M PLCMDB_WORDADR	    EQU     15
                            	     2M _000544BITDEF    SET     1<<15
                            	     3M 	    BITDEF0 PLCMD,WORDADR,F_,_000544BITDEF
                            	     1M PLCMDF_WORDADR	    EQU     _000544BITDEF
                            	   598:  BITDEF PLCMD,CTRL,14
                            	     1M 	    BITDEF0 PLCMD,CTRL,B_,14
                            	     1M PLCMDB_CTRL	    EQU     14
                            	     2M _000547BITDEF    SET     1<<14
                            	     3M 	    BITDEF0 PLCMD,CTRL,F_,_000547BITDEF
                            	     1M PLCMDF_CTRL	    EQU     _000547BITDEF
                            	   599: 
                            	   600: 	ENUM	0
                            	     1M 	    IFC     '0',''
                            	     2M EOFFSET	    SET	    0		; Default to zero
                            	     3M 	    ENDC
                            	     4M 	    IFNC    '0',''
                            	     5M EOFFSET	    SET     0
                            	     6M 	    ENDC
                            	   601: 	EITEM	PLCMD_END		;end of list
                            	     1M PLCMD_END	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   602: 	EITEM	PLCMD_R			;set RTS
                            	     1M PLCMD_R	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   603: 	EITEM	PLCMD_P			;set JMP
                            	     1M PLCMD_P	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   604: 	EITEM	PLCMD_PS		;set JSR
                            	     1M PLCMD_PS	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   605: 	EITEM	PLCMD_S			;set BRA (skip)
                            	     1M PLCMD_S	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   606: 	EITEM	PLCMD_I			;set ILLEGAL
                            	     1M PLCMD_I	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   607: 	EITEM	PLCMD_B			;write byte to specified address
                            	     1M PLCMD_B	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   608: 	EITEM	PLCMD_W			;write word to specified address
                            	     1M PLCMD_W	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   609: 	EITEM	PLCMD_L			;write long to specified address
                            	     1M PLCMD_L	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   610: ; version 11
                            	   611: 	EITEM	PLCMD_A			;write address which is calculated as
                            	     1M PLCMD_A	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   612: 					;base + arg to specified address
                            	   613: ; version 14
                            	   614: 	EITEM	PLCMD_PA		;write address given by argument to
                            	     1M PLCMD_PA	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   615: 					;specified address
                            	   616: 	EITEM	PLCMD_NOP		;fill given area with NOP instructions
                            	     1M PLCMD_NOP	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   617: ; version 15
                            	   618: 	EITEM	PLCMD_C			;clear n bytes
                            	     1M PLCMD_C	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   619: 	EITEM	PLCMD_CB		;clear one byte
                            	     1M PLCMD_CB	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   620: 	EITEM	PLCMD_CW		;clear one word
                            	     1M PLCMD_CW	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   621: 	EITEM	PLCMD_CL		;clear one long
                            	     1M PLCMD_CL	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   622: ; version 16
                            	   623: 	EITEM	PLCMD_PSS		;set JSR + NOP..
                            	     1M PLCMD_PSS	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   624: 	EITEM	PLCMD_NEXT		;continue with another patch list
                            	     1M PLCMD_NEXT	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   625: 	EITEM	PLCMD_AB		;add byte to specified address
                            	     1M PLCMD_AB	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   626: 	EITEM	PLCMD_AW		;add word to specified address
                            	     1M PLCMD_AW	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   627: 	EITEM	PLCMD_AL		;add long to specified address
                            	     1M PLCMD_AL	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   628: 	EITEM	PLCMD_DATA		;write n data bytes to specified address
                            	     1M PLCMD_DATA	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   629: ; version 16.5
                            	   630: 	EITEM	PLCMD_ORB		;or byte to specified address
                            	     1M PLCMD_ORB	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   631: 	EITEM	PLCMD_ORW		;or word to specified address
                            	     1M PLCMD_ORW	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   632: 	EITEM	PLCMD_ORL		;or long to specified address
                            	     1M PLCMD_ORL	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   633: ; version 16.6
                            	   634: 	EITEM	PLCMD_GA		;get specified address and store it in the slave
                            	     1M PLCMD_GA	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   635: ; version 16.9
                            	   636: 	EITEM	PLCMD_BKPT		;call freezer
                            	     1M PLCMD_BKPT	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   637: 	EITEM	PLCMD_BELL		;show visual bell
                            	     1M PLCMD_BELL	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   638: ; version 17.2
                            	   639: 	EITEM	PLCMD_IFBW		;condition if ButtonWait/S
                            	     1M PLCMD_IFBW	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   640: 	EITEM	PLCMD_IFC1		;condition if Custom1/N
                            	     1M PLCMD_IFC1	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   641: 	EITEM	PLCMD_IFC2		;condition if Custom2/N
                            	     1M PLCMD_IFC2	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   642: 	EITEM	PLCMD_IFC3		;condition if Custom3/N
                            	     1M PLCMD_IFC3	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   643: 	EITEM	PLCMD_IFC4		;condition if Custom4/N
                            	     1M PLCMD_IFC4	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   644: 	EITEM	PLCMD_IFC5		;condition if Custom5/N
                            	     1M PLCMD_IFC5	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   645: 	EITEM	PLCMD_IFC1X		;condition if bit of Custom1/N
                            	     1M PLCMD_IFC1X	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   646: 	EITEM	PLCMD_IFC2X		;condition if bit of Custom2/N
                            	     1M PLCMD_IFC2X	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   647: 	EITEM	PLCMD_IFC3X		;condition if bit of Custom3/N
                            	     1M PLCMD_IFC3X	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   648: 	EITEM	PLCMD_IFC4X		;condition if bit of Custom4/N
                            	     1M PLCMD_IFC4X	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   649: 	EITEM	PLCMD_IFC5X		;condition if bit of Custom5/N
                            	     1M PLCMD_IFC5X	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   650: 	EITEM	PLCMD_ELSE		;condition alternative
                            	     1M PLCMD_ELSE	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   651: 	EITEM	PLCMD_ENDIF		;end of condition block
                            	     1M PLCMD_ENDIF	    EQU     EOFFSET
                            	     2M EOFFSET     SET     EOFFSET+1
                            	   652: 
                            	   653: ;=============================================================================
                            	   654: ; macros to build patchlist
                            	   655: 
                            	   656: PLIFCNTCHK	MACRO
                            	   657: 	IFNE PLIFCNT
                            	   658: 	FAIL	\1 pairs of IF* and ENDIF do not match
                            	   659: 	ENDC
                            	   660: 	ENDM
                            	   661: PLIFCNTINC	MACRO
                            	   662: PLIFCNT SET PLIFCNT+1
                            	   663: 	ENDM
                            	   664: 
                            	   665: PL_START	MACRO			;start of patchlist
                            	   666: PLIFCNT SET 0				;counts if nesting
                            	   667: .patchlist
                            	   668: 		ENDM
                            	   669: 
                            	   670: PL_END		MACRO			;end of patchlist
                            	   671: 	PLIFCNTCHK PL_END
                            	   672: 	dc.w	PLCMD_END
                            	   673: 		ENDM
                            	   674: 
                            	   675: PL_CMDADR	MACRO			;set cmd and address
                            	   676: 	IFLT \2
                            	   677: 	FAIL	PL_CMDADR patch address cannot be negative
                            	   678: 	ENDC
                            	   679: 	IFLT $ffff-\2
                            	   680: 	dc.w	\1
                            	   681: 	dc.l	\2
                            	   682: 	ELSE
                            	   683: 	dc.w	PLCMDF_WORDADR+\1
                            	   684: 	dc.w	\2
                            	   685: 	ENDC
                            	   686: 	ENDM
                            	   687: 
                            	   688: PL_R		MACRO			;set "rts"
                            	   689: 	IFNE	NARG-1
                            	   690: 	FAIL	PL_R wrong number of arguments
                            	   691: 	ENDC
                            	   692: 	PL_CMDADR PLCMD_R,\1
                            	   693: 		ENDM
                            	   694: 
                            	   695: PL_PS		MACRO			;set "jsr"
                            	   696: 	IFNE	NARG-2
                            	   697: 	FAIL	PL_PS wrong number of arguments
                            	   698: 	ENDC
                            	   699: 	PL_CMDADR PLCMD_PS,\1
                            	   700: 	dc.w	\2-.patchlist		;destination (inside slave!)
                            	   701: 		ENDM
                            	   702: 
                            	   703: PL_P		MACRO			;set "jmp"
                            	   704: 	IFNE	NARG-2
                            	   705: 	FAIL	PL_P wrong number of arguments
                            	   706: 	ENDC
                            	   707: 	PL_CMDADR PLCMD_P,\1
                            	   708: 	dc.w	\2-.patchlist		;destination (inside slave!)
                            	   709: 		ENDM
                            	   710: 
                            	   711: PL_S		MACRO			;skip bytes, set "bra"
                            	   712: 	IFNE	NARG-2
                            	   713: 	FAIL	PL_S wrong number of arguments
                            	   714: 	ENDC
                            	   715: 	IFLT $8000-(\2)
                            	   716: 	FAIL PL_S positive distance \2 too large, max is $8000
                            	   717: 	ENDC
                            	   718: 	IFGT -$7ffe-(\2)
                            	   719: 	FAIL PL_S negative distance \2 too large, max is -$7ffe
                            	   720: 	ENDC
                            	   721: 	PL_CMDADR PLCMD_S,\1
                            	   722: 	dc.w	\2-2			;distance
                            	   723: 		ENDM
                            	   724: 
                            	   725: PL_I		MACRO			;set "illegal"
                            	   726: 	IFNE	NARG-1
                            	   727: 	FAIL	PL_I wrong number of arguments
                            	   728: 	ENDC
                            	   729: 	PL_CMDADR PLCMD_I,\1
                            	   730: 		ENDM
                            	   731: 
                            	   732: PL_B		MACRO			;write byte
                            	   733: 	IFNE	NARG-2
                            	   734: 	FAIL	PL_B wrong number of arguments
                            	   735: 	ENDC
                            	   736: 	PL_CMDADR PLCMD_B,\1
                            	   737: 	dc.w	\2			;data to write
                            	   738: 		ENDM
                            	   739: 
                            	   740: PL_W		MACRO			;write word
                            	   741: 	IFNE	NARG-2
                            	   742: 	FAIL	PL_W wrong number of arguments
                            	   743: 	ENDC
                            	   744: 	PL_CMDADR PLCMD_W,\1
                            	   745: 	dc.w	\2			;data to write
                            	   746: 		ENDM
                            	   747: 
                            	   748: PL_L		MACRO			;write long
                            	   749: 	IFNE	NARG-2
                            	   750: 	FAIL	PL_L wrong number of arguments
                            	   751: 	ENDC
                            	   752: 	PL_CMDADR PLCMD_L,\1
                            	   753: 	dc.l	\2			;data to write
                            	   754: 		ENDM
                            	   755: 
                            	   756: ; version 11
                            	   757: 
                            	   758: PL_A		MACRO			;write address (base+arg)
                            	   759: 	IFNE	NARG-2
                            	   760: 	FAIL	PL_A wrong number of arguments
                            	   761: 	ENDC
                            	   762: 	PL_CMDADR PLCMD_A,\1
                            	   763: 	dc.l	\2			;data to write
                            	   764: 		ENDM
                            	   765: 
                            	   766: ; version 14
                            	   767: 
                            	   768: PL_PA		MACRO			;write address
                            	   769: 	IFNE	NARG-2
                            	   770: 	FAIL	PL_PA wrong number of arguments
                            	   771: 	ENDC
                            	   772: 	PL_CMDADR PLCMD_PA,\1
                            	   773: 	dc.w	\2-.patchlist		;destination (inside slave!)
                            	   774: 		ENDM
                            	   775: 
                            	   776: PL_NOP		MACRO			;fill area with NOPs
                            	   777: 	IFNE	NARG-2
                            	   778: 	FAIL	PL_NOP wrong number of arguments
                            	   779: 	ENDC
                            	   780: 	PL_CMDADR PLCMD_NOP,\1
                            	   781: 	dc.w	\2			;distance given in bytes
                            	   782: 		ENDM
                            	   783: PL_NOPS		MACRO			;fill area with NOPs
                            	   784: 	IFNE	NARG-2
                            	   785: 	FAIL	PL_NOPS wrong number of arguments
                            	   786: 	ENDC
                            	   787: 	PL_CMDADR PLCMD_NOP,\1
                            	   788: 	dc.w	2*\2			;distance given in NOP count
                            	   789: 		ENDM
                            	   790: 
                            	   791: ; version 15
                            	   792: 
                            	   793: PL_C		MACRO			;clear area
                            	   794: 	IFNE	NARG-2
                            	   795: 	FAIL	PL_C wrong number of arguments
                            	   796: 	ENDC
                            	   797: 	PL_CMDADR PLCMD_C,\1
                            	   798: 	dc.w	\2			;length
                            	   799: 		ENDM
                            	   800: 
                            	   801: PL_CB		MACRO			;clear one byte
                            	   802: 	IFNE	NARG-1
                            	   803: 	FAIL	PL_CB wrong number of arguments
                            	   804: 	ENDC
                            	   805: 	PL_CMDADR PLCMD_CB,\1
                            	   806: 		ENDM
                            	   807: 
                            	   808: PL_CW		MACRO			;clear one word
                            	   809: 	IFNE	NARG-1
                            	   810: 	FAIL	PL_CW wrong number of arguments
                            	   811: 	ENDC
                            	   812: 	PL_CMDADR PLCMD_CW,\1
                            	   813: 		ENDM
                            	   814: 
                            	   815: PL_CL		MACRO			;clear one long
                            	   816: 	IFNE	NARG-1
                            	   817: 	FAIL	PL_CL wrong number of arguments
                            	   818: 	ENDC
                            	   819: 	PL_CMDADR PLCMD_CL,\1
                            	   820: 		ENDM
                            	   821: 
                            	   822: ; version 16
                            	   823: 
                            	   824: PL_PSS		MACRO			;set JSR, NOP..
                            	   825: 	IFNE	NARG-3
                            	   826: 	FAIL	PL_PSS wrong number of arguments
                            	   827: 	ENDC
                            	   828: 	PL_CMDADR PLCMD_PSS,\1
                            	   829: 	dc.w	\2-.patchlist		;destination (inside slave!)
                            	   830: 	dc.w	\3			;byte count of NOPs to append
                            	   831: 		ENDM
                            	   832: 
                            	   833: PL_NEXT		MACRO			;continue with another patch list
                            	   834: 	IFNE	NARG-1
                            	   835: 	FAIL	PL_NEXT wrong number of arguments
                            	   836: 	ENDC
                            	   837: 	PLIFCNTCHK PL_NEXT
                            	   838: 	PL_CMDADR PLCMD_NEXT,0
                            	   839: 	dc.w	\1-.patchlist		;destination (inside slave!)
                            	   840: 		ENDM
                            	   841: 
                            	   842: PL_AB		MACRO			;add byte
                            	   843: 	IFNE	NARG-2
                            	   844: 	FAIL	PL_AB wrong number of arguments
                            	   845: 	ENDC
                            	   846: 	PL_CMDADR PLCMD_AB,\1
                            	   847: 	dc.w	\2			;data to add
                            	   848: 		ENDM
                            	   849: 
                            	   850: PL_AW		MACRO			;add word
                            	   851: 	IFNE	NARG-2
                            	   852: 	FAIL	PL_AW wrong number of arguments
                            	   853: 	ENDC
                            	   854: 	PL_CMDADR PLCMD_AW,\1
                            	   855: 	dc.w	\2			;data to add
                            	   856: 		ENDM
                            	   857: 
                            	   858: PL_AL		MACRO			;add long
                            	   859: 	IFNE	NARG-2
                            	   860: 	FAIL	PL_AL wrong number of arguments
                            	   861: 	ENDC
                            	   862: 	PL_CMDADR PLCMD_AL,\1
                            	   863: 	dc.l	\2			;data to add
                            	   864: 		ENDM
                            	   865: 
                            	   866: ; there are three macros provided for the DATA command, if you want change a 
                            	   867: ; string PL_STR can be used:
                            	   868: ;	PL_STR	$340,<NewString!>
                            	   869: ; if the string should be 0-terminated at the destination PL_STR0 can be used:
                            	   870: ;	PL_STR0	$340,<New C-String>
                            	   871: ; for binary data you must use PL_DATA according the following example:
                            	   872: ;	PL_DATA	$350,.stop-.strt
                            	   873: ; .strt	dc.b	2,3,$ff,'a',0
                            	   874: ;	move.w	#$600,d0
                            	   875: ; .stop	EVEN
                            	   876: 
                            	   877: PL_DATA		MACRO			;write n bytes to specified address
                            	   878: 	IFNE	NARG-2
                            	   879: 	FAIL	PL_DATA wrong number of arguments
                            	   880: 	ENDC
                            	   881: 	PL_CMDADR PLCMD_DATA,\1
                            	   882: 	dc.w	\2			;count of bytes to write
                            	   883: 		ENDM
                            	   884: 
                            	   885: PL_STR		MACRO
                            	   886: 	IFNE	NARG-2
                            	   887: 	FAIL	PL_STR wrong number of arguments
                            	   888: 	ENDC
                            	   889: 	PL_CMDADR PLCMD_DATA,\1
                            	   890: 	dc.w	.dat2\@-.dat1\@
                            	   891: .dat1\@	dc.b	"\2"
                            	   892: .dat2\@
                            	   893: 	EVEN
                            	   894: 		ENDM	
                            	   895: 
                            	   896: PL_STR0		MACRO
                            	   897: 	IFNE	NARG-2
                            	   898: 	FAIL	PL_STR0 wrong number of arguments
                            	   899: 	ENDC
                            	   900: 	PL_CMDADR PLCMD_DATA,\1
                            	   901: 	dc.w	.dat2\@-.dat1\@
                            	   902: .dat1\@	dc.b	"\2",0
                            	   903: .dat2\@
                            	   904: 	EVEN
                            	   905: 		ENDM	
                            	   906: 
                            	   907: ; version 16.5
                            	   908: 
                            	   909: PL_ORB		MACRO			;or byte
                            	   910: 	IFNE	NARG-2
                            	   911: 	FAIL	PL_ORB wrong number of arguments
                            	   912: 	ENDC
                            	   913: 	PL_CMDADR PLCMD_ORB,\1
                            	   914: 	dc.w	\2			;data to or
                            	   915: 		ENDM
                            	   916: 
                            	   917: PL_ORW		MACRO			;or word
                            	   918: 	IFNE	NARG-2
                            	   919: 	FAIL	PL_ORW wrong number of arguments
                            	   920: 	ENDC
                            	   921: 	PL_CMDADR PLCMD_ORW,\1
                            	   922: 	dc.w	\2			;data to or
                            	   923: 		ENDM
                            	   924: 
                            	   925: PL_ORL		MACRO			;or long
                            	   926: 	IFNE	NARG-2
                            	   927: 	FAIL	PL_ORL wrong number of arguments
                            	   928: 	ENDC
                            	   929: 	PL_CMDADR PLCMD_ORL,\1
                            	   930: 	dc.l	\2			;data to or
                            	   931: 		ENDM
                            	   932: 
                            	   933: ; version 16.6
                            	   934: 
                            	   935: PL_GA		MACRO			;get address
                            	   936: 	IFNE	NARG-2
                            	   937: 	FAIL	PL_GA wrong number of arguments
                            	   938: 	ENDC
                            	   939: 	PL_CMDADR PLCMD_GA,\1
                            	   940: 	dc.w	\2-.patchlist		;destination (inside slave!)
                            	   941: 		ENDM
                            	   942: 
                            	   943: ; version 16.9
                            	   944: 
                            	   945: ; PL_BKPT sets a breakpoint:
                            	   946: ; WHDLoad will write an ILLEGAL ($4afc) to the address and remembers the
                            	   947: ; original contents, when the ILLEGAL is executed the original contents is
                            	   948: ; restored, a NMI stackframe is created and the detected freezer called
                            	   949: ; if there is no freezer nothing will be done, the VBR should be moved by
                            	   950: ; WHDLoad to allow catching the illegal instruction exception
                            	   951: 
                            	   952: PL_BKPT		MACRO
                            	   953: 	IFNE	NARG-1
                            	   954: 	FAIL	PL_BKPT wrong number of arguments
                            	   955: 	ENDC
                            	   956: 	PL_CMDADR PLCMD_BKPT,\1
                            	   957: 		ENDM
                            	   958: 
                            	   959: ; PL_BELL shows a visual bell:
                            	   960: ; similar to PL_BKPT, instead of entering a freezer a color cycle will be
                            	   961: ; shown for the given time or lmb pressed, time is given in 1/10s
                            	   962: 
                            	   963: PL_BELL		MACRO
                            	   964: 	IFNE	NARG-2
                            	   965: 	FAIL	PL_BELL wrong number of arguments (adr,time)
                            	   966: 	ENDC
                            	   967: 	PL_CMDADR PLCMD_BELL,\1
                            	   968: 	dc.w	\2			;time to wait
                            	   969: 		ENDM
                            	   970: 
                            	   971: ; version 17.2
                            	   972: 
                            	   973: PL_IFBW		MACRO
                            	   974: 	IFNE	NARG
                            	   975: 	FAIL	PL_IFBW no arguments allowed
                            	   976: 	ENDC
                            	   977: 	PLIFCNTINC
                            	   978: 	dc.w	PLCMDF_CTRL+PLCMD_IFBW
                            	   979: 		ENDM
                            	   980: PL_IFC1		MACRO
                            	   981: 	IFNE	NARG
                            	   982: 	FAIL	PL_IFC1 no arguments allowed
                            	   983: 	ENDC
                            	   984: 	PLIFCNTINC
                            	   985: 	dc.w	PLCMDF_CTRL+PLCMD_IFC1
                            	   986: 		ENDM
                            	   987: PL_IFC2		MACRO
                            	   988: 	IFNE	NARG
                            	   989: 	FAIL	PL_IFC2 no arguments allowed
                            	   990: 	ENDC
                            	   991: 	PLIFCNTINC
                            	   992: 	dc.w	PLCMDF_CTRL+PLCMD_IFC2
                            	   993: 		ENDM
                            	   994: PL_IFC3		MACRO
                            	   995: 	IFNE	NARG
                            	   996: 	FAIL	PL_IFC3 no arguments allowed
                            	   997: 	ENDC
                            	   998: 	PLIFCNTINC
                            	   999: 	dc.w	PLCMDF_CTRL+PLCMD_IFC3
                            	  1000: 		ENDM
                            	  1001: PL_IFC4		MACRO
                            	  1002: 	IFNE	NARG
                            	  1003: 	FAIL	PL_IFC4 no arguments allowed
                            	  1004: 	ENDC
                            	  1005: 	PLIFCNTINC
                            	  1006: 	dc.w	PLCMDF_CTRL+PLCMD_IFC4
                            	  1007: 		ENDM
                            	  1008: PL_IFC5		MACRO
                            	  1009: 	IFNE	NARG
                            	  1010: 	FAIL	PL_IFC5 no arguments allowed
                            	  1011: 	ENDC
                            	  1012: 	PLIFCNTINC
                            	  1013: 	dc.w	PLCMDF_CTRL+PLCMD_IFC5
                            	  1014: 		ENDM
                            	  1015: PL_IFC1X	MACRO
                            	  1016: 	IFNE	NARG-1
                            	  1017: 	FAIL	PL_IFC1X wrong number of arguments
                            	  1018: 	ENDC
                            	  1019: 	IFGT	\1-31
                            	  1020: 	FAIL	PL_IFC1X bit number must be 0..31
                            	  1021: 	ENDC
                            	  1022: 	PLIFCNTINC
                            	  1023: 	dc.w	PLCMDF_CTRL+PLCMD_IFC1X,\1
                            	  1024: 		ENDM
                            	  1025: PL_IFC2X	MACRO
                            	  1026: 	IFNE	NARG-1
                            	  1027: 	FAIL	PL_IFC2X wrong number of arguments
                            	  1028: 	ENDC
                            	  1029: 	IFGT	\1-31
                            	  1030: 	FAIL	PL_IFC2X bit number must be 0..31
                            	  1031: 	ENDC
                            	  1032: 	PLIFCNTINC
                            	  1033: 	dc.w	PLCMDF_CTRL+PLCMD_IFC2X,\1
                            	  1034: 		ENDM
                            	  1035: PL_IFC3X	MACRO
                            	  1036: 	IFNE	NARG-1
                            	  1037: 	FAIL	PL_IFC3X wrong number of arguments
                            	  1038: 	ENDC
                            	  1039: 	IFGT	\1-31
                            	  1040: 	FAIL	PL_IFC3X bit number must be 0..31
                            	  1041: 	ENDC
                            	  1042: 	PLIFCNTINC
                            	  1043: 	dc.w	PLCMDF_CTRL+PLCMD_IFC3X,\1
                            	  1044: 		ENDM
                            	  1045: PL_IFC4X	MACRO
                            	  1046: 	IFNE	NARG-1
                            	  1047: 	FAIL	PL_IFC4X wrong number of arguments
                            	  1048: 	ENDC
                            	  1049: 	IFGT	\1-31
                            	  1050: 	FAIL	PL_IFC4X bit number must be 0..31
                            	  1051: 	ENDC
                            	  1052: 	PLIFCNTINC
                            	  1053: 	dc.w	PLCMDF_CTRL+PLCMD_IFC4X,\1
                            	  1054: 		ENDM
                            	  1055: PL_IFC5X	MACRO
                            	  1056: 	IFNE	NARG-1
                            	  1057: 	FAIL	PL_IFC5X wrong number of arguments
                            	  1058: 	ENDC
                            	  1059: 	IFGT	\1-31
                            	  1060: 	FAIL	PL_IFC5X bit number must be 0..31
                            	  1061: 	ENDC
                            	  1062: 	PLIFCNTINC
                            	  1063: 	dc.w	PLCMDF_CTRL+PLCMD_IFC5X,\1
                            	  1064: 		ENDM
                            	  1065: PL_ELSE		MACRO
                            	  1066: 	IFNE	NARG
                            	  1067: 	FAIL	PL_ELSE no arguments allowed
                            	  1068: 	ENDC
                            	  1069: 	IFLE PLIFCNT
                            	  1070: 	FAIL	PL_ELSE there must be an PL_IF* before
                            	  1071: 	ENDC
                            	  1072: 	dc.w	PLCMDF_CTRL+PLCMD_ELSE
                            	  1073: 		ENDM
                            	  1074: PL_ENDIF	MACRO
                            	  1075: 	IFNE	NARG
                            	  1076: 	FAIL	PL_ENDIF no arguments allowed
                            	  1077: 	ENDC
                            	  1078: 	IFLE PLIFCNT
                            	  1079: 	FAIL	PL_ENDIF there must be an PL_IF* before
                            	  1080: 	ENDC
                            	  1081: PLIFCNT SET PLIFCNT-1
                            	  1082: 	dc.w	PLCMDF_CTRL+PLCMD_ENDIF
                            	  1083: 		ENDM
                            	  1084: 
                            	  1085: ;=============================================================================
                            	  1086: ; flags for resload_ReadJoyPort
                            	  1087: ;=============================================================================
                            	  1088: 
                            	  1089: ; input flags:
                            	  1090: 
                            	  1091:  BITDEF RJP,DETECT,31		; request new detection (GAMECTRL/JOYSTK)
                            	     1M 	    BITDEF0 RJP,DETECT,B_,31
                            	     1M RJPB_DETECT	    EQU     31
                            	     2M _000592BITDEF    SET     1<<31
                            	     3M 	    BITDEF0 RJP,DETECT,F_,_000592BITDEF
                            	     1M RJPF_DETECT	    EQU     _000592BITDEF
                            	  1092:  BITDEF RJP,WANTMOUSE,30	; get mouse result
                            	     1M 	    BITDEF0 RJP,WANTMOUSE,B_,30
                            	     1M RJPB_WANTMOUSE	    EQU     30
                            	     2M _000595BITDEF    SET     1<<30
                            	     3M 	    BITDEF0 RJP,WANTMOUSE,F_,_000595BITDEF
                            	     1M RJPF_WANTMOUSE	    EQU     _000595BITDEF
                            	  1093: 
                            	  1094: ; output flags:
                            	  1095: 
                            	  1096: RJP_TYPE_GAMECTRL = 1<<28	; cd32pad
                            	  1097: RJP_TYPE_MOUSE = 2<<28		; mouse
                            	  1098: RJP_TYPE_JOYSTK = 3<<28		; joystick
                            	  1099: RJP_TYPE_MASK	= 15<<28
                            	  1100: 
                            	  1101:  BITDEF RJP,BLUE,23		; pad-blue/stop, mouse-right, stick-2nd-fire
                            	     1M 	    BITDEF0 RJP,BLUE,B_,23
                            	     1M RJPB_BLUE	    EQU     23
                            	     2M _000598BITDEF    SET     1<<23
                            	     3M 	    BITDEF0 RJP,BLUE,F_,_000598BITDEF
                            	     1M RJPF_BLUE	    EQU     _000598BITDEF
                            	  1102:  BITDEF RJP,RED,22		; pad-red/select, mouse-left, stick-fire
                            	     1M 	    BITDEF0 RJP,RED,B_,22
                            	     1M RJPB_RED	    EQU     22
                            	     2M _000601BITDEF    SET     1<<22
                            	     3M 	    BITDEF0 RJP,RED,F_,_000601BITDEF
                            	     1M RJPF_RED	    EQU     _000601BITDEF
                            	  1103:  BITDEF RJP,YELLOW,21		; pad-yellow/repeat
                            	     1M 	    BITDEF0 RJP,YELLOW,B_,21
                            	     1M RJPB_YELLOW	    EQU     21
                            	     2M _000604BITDEF    SET     1<<21
                            	     3M 	    BITDEF0 RJP,YELLOW,F_,_000604BITDEF
                            	     1M RJPF_YELLOW	    EQU     _000604BITDEF
                            	  1104:  BITDEF RJP,GREEN,20		; pad-green/shuffle
                            	     1M 	    BITDEF0 RJP,GREEN,B_,20
                            	     1M RJPB_GREEN	    EQU     20
                            	     2M _000607BITDEF    SET     1<<20
                            	     3M 	    BITDEF0 RJP,GREEN,F_,_000607BITDEF
                            	     1M RJPF_GREEN	    EQU     _000607BITDEF
                            	  1105:  BITDEF RJP,FORWARD,19		; pad-forward
                            	     1M 	    BITDEF0 RJP,FORWARD,B_,19
                            	     1M RJPB_FORWARD	    EQU     19
                            	     2M _000610BITDEF    SET     1<<19
                            	     3M 	    BITDEF0 RJP,FORWARD,F_,_000610BITDEF
                            	     1M RJPF_FORWARD	    EQU     _000610BITDEF
                            	  1106:  BITDEF RJP,REVERSE,18		; pad-reverse
                            	     1M 	    BITDEF0 RJP,REVERSE,B_,18
                            	     1M RJPB_REVERSE	    EQU     18
                            	     2M _000613BITDEF    SET     1<<18
                            	     3M 	    BITDEF0 RJP,REVERSE,F_,_000613BITDEF
                            	     1M RJPF_REVERSE	    EQU     _000613BITDEF
                            	  1107:  BITDEF RJP,PLAY,17		; pad-play/pause, mouse-middle, stick-3rd-fire
                            	     1M 	    BITDEF0 RJP,PLAY,B_,17
                            	     1M RJPB_PLAY	    EQU     17
                            	     2M _000616BITDEF    SET     1<<17
                            	     3M 	    BITDEF0 RJP,PLAY,F_,_000616BITDEF
                            	     1M RJPF_PLAY	    EQU     _000616BITDEF
                            	  1108: 
                            	  1109:  BITDEF RJP,UP,3
                            	     1M 	    BITDEF0 RJP,UP,B_,3
                            	     1M RJPB_UP	    EQU     3
                            	     2M _000619BITDEF    SET     1<<3
                            	     3M 	    BITDEF0 RJP,UP,F_,_000619BITDEF
                            	     1M RJPF_UP	    EQU     _000619BITDEF
                            	  1110:  BITDEF RJP,DOWN,2
                            	     1M 	    BITDEF0 RJP,DOWN,B_,2
                            	     1M RJPB_DOWN	    EQU     2
                            	     2M _000622BITDEF    SET     1<<2
                            	     3M 	    BITDEF0 RJP,DOWN,F_,_000622BITDEF
                            	     1M RJPF_DOWN	    EQU     _000622BITDEF
                            	  1111:  BITDEF RJP,LEFT,1
                            	     1M 	    BITDEF0 RJP,LEFT,B_,1
                            	     1M RJPB_LEFT	    EQU     1
                            	     2M _000625BITDEF    SET     1<<1
                            	     3M 	    BITDEF0 RJP,LEFT,F_,_000625BITDEF
                            	     1M RJPF_LEFT	    EQU     _000625BITDEF
                            	  1112:  BITDEF RJP,RIGHT,0
                            	     1M 	    BITDEF0 RJP,RIGHT,B_,0
                            	     1M RJPB_RIGHT	    EQU     0
                            	     2M _000628BITDEF    SET     1<<0
                            	     3M 	    BITDEF0 RJP,RIGHT,F_,_000628BITDEF
                            	     1M RJPF_RIGHT	    EQU     _000628BITDEF
                            	  1113: 
                            	  1114: RJP_MHORZ_MASK = 255<<0		; mouse horizontal position
                            	  1115: RJP_MVERT_MASK = 255<<8		; mouse vertical position
                            	  1116: 
                            	  1117: ;=============================================================================
                            	  1118: 
                            	  1119:  ENDC
                            	  1120: 

