Source: "exec\types.i"
                            	     1: 	IFND	EXEC_TYPES_I
                            	     2: EXEC_TYPES_I	SET	1
                            	     3: **
                            	     4: **	$VER: types.i 47.1 (28.7.2019)
                            	     5: **
                            	     6: **	Data storage macros.  Must be included before any other Amiga include.
                            	     7: **
                            	     8: **	Copyright (C) 2019 Hyperion Entertainment CVBA.
                            	     9: **	    Developed under license.
                            	    10: **
                            	    11: 
                            	    12: 
                            	    13: INCLUDE_VERSION	EQU 47	;Version of the include files in use. (Do not
                            	    14: 			;use this label for OpenLibrary() calls!)
                            	    15: 
                            	    16: 
                            	    17: EXTERN_LIB  MACRO
                            	    18: 	    XREF    _LVO\1
                            	    19: 	    ENDM
                            	    20: 
                            	    21: **
                            	    22: ** Structure Building Macros
                            	    23: **
                            	    24: STRUCTURE   MACRO		; structure name, initial offset
                            	    25: \1	    EQU     0
                            	    26: SOFFSET     SET     \2
                            	    27: 	    ENDM
                            	    28: 
                            	    29: FPTR	    MACRO		; function pointer (32 bits - all bits valid)
                            	    30: \1	    EQU     SOFFSET
                            	    31: SOFFSET     SET     SOFFSET+4
                            	    32: 	    ENDM
                            	    33: 
                            	    34: BOOL	    MACRO		; boolean (16 bits)
                            	    35: \1	    EQU     SOFFSET
                            	    36: SOFFSET     SET     SOFFSET+2
                            	    37: 	    ENDM
                            	    38: 
                            	    39: BYTE	    MACRO		; byte (8 bits)
                            	    40: \1	    EQU     SOFFSET
                            	    41: SOFFSET     SET     SOFFSET+1
                            	    42: 	    ENDM
                            	    43: 
                            	    44: UBYTE	    MACRO		; unsigned byte (8 bits)
                            	    45: \1	    EQU     SOFFSET
                            	    46: SOFFSET     SET     SOFFSET+1
                            	    47: 	    ENDM
                            	    48: 
                            	    49: WORD	    MACRO		; word (16 bits)
                            	    50: \1	    EQU     SOFFSET
                            	    51: SOFFSET     SET     SOFFSET+2
                            	    52: 	    ENDM
                            	    53: 
                            	    54: UWORD	    MACRO		; unsigned word (16 bits)
                            	    55: \1	    EQU     SOFFSET
                            	    56: SOFFSET     SET     SOFFSET+2
                            	    57: 	    ENDM
                            	    58: 
                            	    59: SHORT	    MACRO		; obsolete - use WORD
                            	    60: \1	    EQU     SOFFSET
                            	    61: SOFFSET     SET     SOFFSET+2
                            	    62: 	    ENDM
                            	    63: 
                            	    64: USHORT	    MACRO		; obsolete - use UWORD
                            	    65: \1	    EQU     SOFFSET
                            	    66: SOFFSET     SET     SOFFSET+2
                            	    67: 	    ENDM
                            	    68: 
                            	    69: LONG	    MACRO		; long (32 bits)
                            	    70: \1	    EQU     SOFFSET
                            	    71: SOFFSET     SET     SOFFSET+4
                            	    72: 	    ENDM
                            	    73: 
                            	    74: ULONG	    MACRO		; unsigned long (32 bits)
                            	    75: \1	    EQU     SOFFSET
                            	    76: SOFFSET     SET     SOFFSET+4
                            	    77: 	    ENDM
                            	    78: 
                            	    79: FLOAT	    MACRO		; C float (32 bits)
                            	    80: \1	    EQU     SOFFSET
                            	    81: SOFFSET     SET     SOFFSET+4
                            	    82: 	    ENDM
                            	    83: 
                            	    84: DOUBLE	    MACRO		; C double (64 bits)
                            	    85: \1	    EQU	    SOFFSET
                            	    86: SOFFSET	    SET	    SOFFSET+8
                            	    87: 	    ENDM
                            	    88: 
                            	    89: APTR	    MACRO		; untyped pointer (32 bits - all bits valid)
                            	    90: \1	    EQU     SOFFSET
                            	    91: SOFFSET     SET     SOFFSET+4
                            	    92: 	    ENDM
                            	    93: 
                            	    94: CPTR	    MACRO		; obsolete
                            	    95: \1	    EQU     SOFFSET
                            	    96: SOFFSET     SET     SOFFSET+4
                            	    97: 	    ENDM
                            	    98: 
                            	    99: RPTR	    MACRO		; unsigned relative pointer (16 bits)
                            	   100: \1	    EQU     SOFFSET
                            	   101: SOFFSET     SET     SOFFSET+2
                            	   102: 	    ENDM
                            	   103: 
                            	   104: LABEL	    MACRO		; Define a label without bumping the offset
                            	   105: \1	    EQU     SOFFSET
                            	   106: 	    ENDM
                            	   107: 
                            	   108: STRUCT	    MACRO		; Define a sub-structure
                            	   109: \1	    EQU     SOFFSET
                            	   110: SOFFSET     SET     SOFFSET+\2
                            	   111: 	    ENDM
                            	   112: 
                            	   113: ALIGNWORD   MACRO		; Align structure offset to nearest word
                            	   114: SOFFSET     SET     (SOFFSET+1)&$fffffffe
                            	   115: 	    ENDM
                            	   116: 
                            	   117: ALIGNLONG   MACRO		; Align structure offset to nearest longword
                            	   118: SOFFSET     SET     (SOFFSET+3)&$fffffffc
                            	   119: 	    ENDM
                            	   120: 
                            	   121: **
                            	   122: ** Enumerated variables.  Use ENUM to set a base number, and EITEM to assign
                            	   123: ** incrementing values.  ENUM can be used to set a new base at any time.
                            	   124: **
                            	   125: ENUM	    MACRO   ;[new base]
                            	   126: 	    IFC     '\1',''
                            	   127: EOFFSET	    SET	    0		; Default to zero
                            	   128: 	    ENDC
                            	   129: 	    IFNC    '\1',''
                            	   130: EOFFSET	    SET     \1
                            	   131: 	    ENDC
                            	   132: 	    ENDM
                            	   133: 
                            	   134: EITEM	    MACRO   ;label
                            	   135: \1	    EQU     EOFFSET
                            	   136: EOFFSET     SET     EOFFSET+1
                            	   137: 	    ENDM
                            	   138: 
                            	   139: **
                            	   140: **  Bit Definition Macro
                            	   141: **
                            	   142: **  Given:
                            	   143: **	BITDEF	MEM,CLEAR,16
                            	   144: **
                            	   145: **  Yields:
                            	   146: **	MEMB_CLEAR  EQU 16			; Bit number
                            	   147: **	MEMF_CLEAR  EQU 1<<16			; Bit mask
                            	   148: **
                            	   149: 
                            	   150: BITDEF	    MACRO   ; prefix,&name,&bitnum
                            	   151: 	    BITDEF0 \1,\2,B_,\3
                            	   152: \@BITDEF    SET     1<<\3
                            	   153: 	    BITDEF0 \1,\2,F_,\@BITDEF
                            	   154: 	    ENDM
                            	   155: 
                            	   156: BITDEF0     MACRO   ; prefix,&name,&type,&value
                            	   157: \1\3\2	    EQU     \4
                            	   158: 	    ENDM
                            	   159: 
                            	   160: **
                            	   161: ** LIBRARY_VERSION is now obsolete.  Please use LIBRARY_MINIMUM or code
                            	   162: ** the specific minimum library version you require.
                            	   163: **		LIBRARY_VERSION EQU	36
                            	   164: **
                            	   165: LIBRARY_MINIMUM	EQU 33	;Lowest version supported
                            	   166: 
                            	   167: 	ENDC	; EXEC_TYPES_I
                            	   168: 

Source: "exec\execbase.i"
                            	    14:     ENDC	; EXEC_TYPES_I
                            	    15: 
