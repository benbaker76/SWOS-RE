                            	    99: ******* System List Headers (private!) ********************************
                            	   100: 
                            	   101: 	STRUCT	MemList,LH_SIZE
                            	     1M MemList	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+LH_SIZE
                            	   102: 	STRUCT	ResourceList,LH_SIZE
                            	     1M ResourceList	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+LH_SIZE
                            	   103: 	STRUCT	DeviceList,LH_SIZE
                            	     1M DeviceList	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+LH_SIZE
                            	   104: 	STRUCT	IntrList,LH_SIZE
                            	     1M IntrList	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+LH_SIZE
                            	   105: 	STRUCT	LibList,LH_SIZE
                            	     1M LibList	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+LH_SIZE
                            	   106: 	STRUCT	PortList,LH_SIZE
                            	     1M PortList	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+LH_SIZE
                            	   107: 	STRUCT	TaskReady,LH_SIZE
                            	     1M TaskReady	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+LH_SIZE
                            	   108: 	STRUCT	TaskWait,LH_SIZE
                            	     1M TaskWait	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+LH_SIZE
                            	   109: 
                            	   110: 	STRUCT	SoftInts,SH_SIZE*5
