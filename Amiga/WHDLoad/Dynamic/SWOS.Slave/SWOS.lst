                            	    17: INVALID_ID			EQU	~0
                            	    18: 
                            	    19: * normal identifiers
                            	    20: 
                            	    21: MONITOR_ID_MASK			EQU	$FFFF1000
                            	    22: 
                            	    23: DEFAULT_MONITOR_ID		EQU	$00000000
                            	    24: NTSC_MONITOR_ID			EQU	$00011000
                            	    25: PAL_MONITOR_ID			EQU	$00021000
                            	    26: 
                            	    27: ** the following 22 composite keys are for Modes on the default Monitor.
                            	    28: ** NTSC & PAL "flavors" of these particular keys may be made by or'ing
                            	    29: ** the NTSC or PAL MONITOR_ID with the desired MODE_KEY...
                            	    30: **
                            	    31: ** For example, to specifically open a PAL HAM interlaced ViewPort
                            	    32: ** (or intuition screen), you would use the modeid of
                            	    33: ** (PAL_MONITOR_ID | HAMLACE_KEY)
                            	    34: **
                            	    35: 
                            	    36: LORES_KEY			EQU	$00000000 
                            	    37: HIRES_KEY			EQU	$00008000 
                            	    38: SUPER_KEY			EQU	$00008020 
                            	    39: HAM_KEY				EQU	$00000800 
                            	    40: LORESLACE_KEY			EQU	$00000004 
                            	    41: HIRESLACE_KEY			EQU	$00008004 
                            	    42: SUPERLACE_KEY			EQU	$00008024 
                            	    43: HAMLACE_KEY			EQU	$00000804 
                            	    44: LORESDPF_KEY			EQU	$00000400 
                            	    45: HIRESDPF_KEY			EQU	$00008400 
                            	    46: SUPERDPF_KEY			EQU	$00008420 
                            	    47: LORESLACEDPF_KEY		EQU	$00000404 
                            	    48: HIRESLACEDPF_KEY		EQU	$00008404 
                            	    49: SUPERLACEDPF_KEY		EQU	$00008424 
                            	    50: LORESDPF2_KEY			EQU	$00000440 
