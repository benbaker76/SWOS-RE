                            	   137: 	;------------------------------------------------------
                            	   138: 	; Load hunk executable "SWOS2" at program_location
                            	   139: 	;------------------------------------------------------
00:000001BA 41FAFFA7        	   140: 	lea     Swos.prg(pc),a0
00:000001BE 227A0278        	   141: 	move.l  program_location(pc),a1
00:000001C2 61000AA6        	   142: 	bsr     _LoadFileDEC           ; A0=name, A1=dest, D0=size
                            	   143: 
                            	   144: 	; (optional) remember file size as "version" if you want
00:000001C6 41FA026C        	   145: 	lea     swos_version(pc),a0
00:000001CA 2080            	   146: 	move.l  d0,(a0)
                            	   147: 
                            	   148: 	;------------------------------------------------------
                            	   149: 	; Relocate AmigaDOS hunk executable in-place
                            	   150: 	;   A0 = start of executable in memory
                            	   151: 	;   A1 = taglist (we pass ALIGN=8 to mimic LoadSeg)
                            	   152: 	;   A2 = _resload
                            	   153: 	;   D0 = size of relocated exe on return
                            	   154: 	;------------------------------------------------------
00:000001CC 207A026A        	   155: 	move.l  program_location(pc),a0    ; address of executable
                            	   156: 
00:000001D0 42A7            	   157:     clr.l   -(a7)                      ; TAG_DONE
00:000001D2 2F3C00010000    	   158: 	move.l  #$10000,-(a7)              ; chip area pointer = $00010000
00:000001D8 487988100000    	   159: 	pea     WHDLTAG_CHIPPTR
00:000001DE 487900000008    	   160: 	pea     8                          ; value
00:000001E4 487988100002    	   161: 	pea     WHDLTAG_ALIGN              ; tag
00:000001EA 224F            	   162: 	move.l  a7,a1                      ; A1 = taglist
                            	   163: 
00:000001EC 247A0232        	   164:     move.l  _resload(pc),a2
00:000001F0 4EAA0050        	   165:     jsr     (resload_Relocate,a2)
                            	   166: 
00:000001F4 DEFC000C        	   167:     add.w   #12,a7
                            	   168: 
                            	   169:     ; keep size of relocated exe in reloc_size (handy for later)
00:000001F8 41FA0236        	   170:     lea     reloc_size(pc),a0
00:000001FC 2080            	   171:     move.l  d0,(a0)
                            	   172: 
00:000001FE 46FC2000        	   173:     move.w  #$2000,sr
                            	   174: 
                            	   175:     ;------------------------------------------------------
                            	   176:     ; Install callback addresses into SWOS2 stubs
                            	   177:     ;------------------------------------------------------
00:00000202 207A0234        	   178:     move.l  program_location(pc),a0    ; A0 = base of relocated SWOS2
00:00000206 61000044        	   179:     bsr     install_callbacks
                            	   180: 
                            	   181: 	; set registers D5-D7 to expected values
00:0000020A 2E3C00200000    	   182: 	move.l  #CHIPMEMSIZE,D7
00:00000210 2A3C0F000000    	   183: 	move.l  #FASTBITS,d5
00:00000216 2C3C0F00000F    	   184: 	move.l  #CHIPBITS|FASTBITS,d6     
                            	   185: 
