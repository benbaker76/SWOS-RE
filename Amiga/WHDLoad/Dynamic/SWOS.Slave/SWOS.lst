                            	    14: 	IFND EXEC_TYPES_I
                            	    15: 	INCLUDE "exec/types.i"
                            	    16: 	ENDC
                            	    17: 
                            	    18: ;---------------------------------------------------------------------------
                            	    19: 
                            	    20: ; Tags are a general mechanism of extensible data arrays for parameter
                            	    21: ; specification and property inquiry. In practice, tags are used in arrays,
                            	    22: ; or chain of arrays.
                            	    23: 
                            	    24:    STRUCTURE TagItem,0
                            	     1M TagItem	    EQU     0
                            	     2M SOFFSET     SET     0
                            	    25: 	ULONG	ti_Tag		; identifies the type of the data
                            	     1M ti_Tag	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    26: 	ULONG	ti_Data		; type-specific data
                            	     1M ti_Data	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    27:    LABEL ti_SIZEOF
                            	     1M ti_SIZEOF	    EQU     SOFFSET
                            	    28: 
                            	    29: ; constants for Tag.ti_Tag, control tag values
                            	    30: TAG_DONE   equ 0  ; terminates array of TagItems. ti_Data unused
                            	    31: TAG_END	   equ 0  ; synonym for TAG_DONE
                            	    32: TAG_IGNORE equ 1  ; ignore this item, not end of array
                            	    33: TAG_MORE   equ 2  ; ti_Data is pointer to another array of TagItems
                            	    34: 		  ; note that this tag terminates the current array
                            	    35: TAG_SKIP   equ 3  ; skip this and the next ti_Data items
                            	    36: 
                            	    37: ; differentiates user tags from control tags
                            	    38: TAG_USER   equ $80000000
                            	    39: 
                            	    40: ; If the TAG_USER bit is set in a tag number, it tells utility.library that
                            	    41: ; the tag is not a control tag (like TAG_DONE, TAG_IGNORE, TAG_MORE) and is
                            	    42: ; instead an application tag. "USER" means a client of utility.library in
                            	    43: ; general, including system code like Intuition or ASL, it has nothing to do
                            	    44: ; with user code.
                            	    45: ;
                            	    46: 
                            	    47: ;---------------------------------------------------------------------------
                            	    48: 
                            	    49: ; Tag filter logic specifiers for use with FilterTagItems()
                            	    50: TAGFILTER_AND equ 0	; exclude everything but filter hits
                            	    51: TAGFILTER_NOT equ 1	; exclude only filter hits
                            	    52: 
                            	    53: ;---------------------------------------------------------------------------
                            	    54: 
                            	    55: ; Mapping types for use with MapTags()
                            	    56: MAP_REMOVE_NOT_FOUND equ 0	; remove tags that aren't in mapList
                            	    57: MAP_KEEP_NOT_FOUND   equ 1	; keep tags that aren't in mapList
                            	    58: 
                            	    59: ;---------------------------------------------------------------------------
                            	    60: 
                            	    61: 	ENDC	; UTILITY_TAGITEM_I
                            	    62: 

Source: "graphics\gfx.i"
                            	    17:     ENDC
