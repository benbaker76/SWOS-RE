                            	   198: avoid_big_value:
00:00000230 4A40            	   199: 	tst.w	d0
00:00000232 6706            	   200: 	beq.b	.fail
00:00000234 B07C0050        	   201: 	cmp.w	#$50,d0
00:00000238 650E            	   202: 	bcs.b	.ok
                            	   203: .fail
                            	   204: 	; value in D0 is bogus, this will trigger an access fault
                            	   205: 	; clear it, the called routine will run in degraded mode, it doesn't
                            	   206: 	; seem to change anything.
                            	   207: 	;
                            	   208: 	; but fix this value in memory to avoid more issues
                            	   209: 	; this will degrade gameplay but won't crash
                            	   210: 
00:0000023A 317C0001FFFE    	   211: 	move.w	#1,(-2,a0)
00:00000240 584F            	   212: 	addq.w	#4,a7
00:00000242 4CDF7FFF        	   213: 	MOVEM.L	(A7)+,D0-D7/A0-A6
00:00000246 4E75            	   214: 	rts
                            	   215: .ok
00:00000248 5340            	   216: 	SUBQ.W	#1,D0			;14dfec: 5340
00:0000024A 4E75            	   217: 	rts
