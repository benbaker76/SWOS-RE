                            	    75: 
                            	    76: ******* Dynamic System Variables *************************************
                            	    77: 
                            	    78: 	APTR	ThisTask	; pointer to current task (readable)
                            	     1M ThisTask	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    79: 
                            	    80: 	ULONG	IdleCount	; idle counter
                            	     1M IdleCount	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    81: 	ULONG	DispCount	; dispatch counter
                            	     1M DispCount	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    82: 	UWORD	Quantum 	; time slice quantum
                            	     1M Quantum	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    83: 	UWORD	Elapsed 	; current quantum ticks
                            	     1M Elapsed	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    84: 	UWORD	SysFlags	; misc internal system flags
                            	     1M SysFlags	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    85: 	BYTE	IDNestCnt	; interrupt disable nesting count
                            	     1M IDNestCnt	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	    86: 	BYTE	TDNestCnt	; task disable nesting count
                            	     1M TDNestCnt	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+1
                            	    87: 
                            	    88: 	UWORD	AttnFlags	; special attention flags (readable)
                            	     1M AttnFlags	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    89: 
                            	    90: 	UWORD	AttnResched	; rescheduling attention
                            	     1M AttnResched	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
                            	    91: 	APTR	ResModules	; pointer to resident module array
                            	     1M ResModules	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    92: 	APTR	TaskTrapCode	; default task trap routine
                            	     1M TaskTrapCode	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    93: 	APTR	TaskExceptCode	; default task exception code
                            	     1M TaskExceptCode	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    94: 	APTR	TaskExitCode	; default task exit code
                            	     1M TaskExitCode	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    95: 	ULONG	TaskSigAlloc	; preallocated signal mask
                            	     1M TaskSigAlloc	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+4
                            	    96: 	UWORD	TaskTrapAlloc	; preallocated trap mask
                            	     1M TaskTrapAlloc	    EQU     SOFFSET
                            	     2M SOFFSET     SET     SOFFSET+2
