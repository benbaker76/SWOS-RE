                            	    65: * mode properties
                            	    66: 
                            	    67: DIPF_IS_LACE			equ	$00000001
                            	    68: DIPF_IS_DUALPF			equ	$00000002
                            	    69: DIPF_IS_PF2PRI			equ	$00000004
                            	    70: DIPF_IS_HAM			equ	$00000008
