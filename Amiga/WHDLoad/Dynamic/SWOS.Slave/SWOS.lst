Source: "whdmacros.i"
                            	     1: ;*---------------------------------------------------------------------------
                            	     2: ;  :Module.	whdmacros.i
                            	     3: ;  :Contens.	useful macros and symbols for WHDLoad-Slaves
                            	     4: ;  :Author.	Bert Jahn
                            	     5: ;  :History.	11.04.99 separated from whdload.i
                            	     6: ;		07.09.00 macro 'skip' fixed for distance of 2
                            	     7: ;		21.09.00 macro 'blitz' small fix
                            	     8: ;		04.06.04 macro 'blitz' improved
                            	     9: ;		29.10.04 macro 'blitz' fixed (oh god what a mess)
                            	    10: ;		27.02.07 waitvbs added
                            	    11: ;		03.09.07 BLITWAIT macro improved
                            	    12: ;		06.09.07 adapted to work with Devpac 3.18
                            	    13: ;		26.12.20 macro 'blitz' no longer uses movem to avoid breaking
                            	    14: ;			 _MOVEMREGS/_MOVEMBYTES 
                            	    15: ;		21.12.20 macro LOG added
                            	    16: ;		22.03.25 macros patch2 and patchs2 added
                            	    17: ;  :Language.	68000 Assembler
                            	    18: ;---------------------------------------------------------------------------*
