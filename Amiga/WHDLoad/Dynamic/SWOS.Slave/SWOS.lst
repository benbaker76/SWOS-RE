                            	    53: LORESLACEDPF2_KEY		EQU	$00000444 
                            	    54: HIRESLACEDPF2_KEY		EQU	$00008444 
                            	    55: SUPERLACEDPF2_KEY		EQU	$00008464 
                            	    56: EXTRAHALFBRITE_KEY		EQU	$00000080 
                            	    57: EXTRAHALFBRITELACE_KEY		EQU	$00000084 
                            	    58: * New for AA ChipSet (V39)
                            	    59: HIRESHAM_KEY			EQU	$00008800
