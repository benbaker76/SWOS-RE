                            	    63: ;=============================================================================
                            	    64: ;	misc
                            	    65: ;=============================================================================
                            	    66: 
                            	    67: SLAVE_HEADER	MACRO
                            	    68: 		moveq	#-1,d0
                            	    69: 		rts
                            	    70: 		dc.b	"WHDLOADS"
                            	    71: 		ENDM
