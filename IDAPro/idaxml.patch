+def normalize_for_ghidra(tname: str) -> str:
+    s = tname.strip()
 
+    # Remove C tag keywords anywhere before an identifier:
+    #   "const struct CharTable *"  -> "const CharTable *"
+    #   "union Foo *"               -> "Foo *"
+    #   "enum  BAR const *"         -> "BAR const *"
+    #   "class Baz **"              -> "Baz **"
+    import re
+    s = re.sub(r'\b(struct|union|enum|class)\s+(?=[A-Za-z_]\w*)', '', s)
+
+    # Apply your existing IDA→Ghidra type mappings
+    for pat, rep in _IDA2GHIDRA_MAP:
+        s = re.sub(pat, rep, s)
+
+    # Tidy whitespace and pointer spacing
+    s = re.sub(r'\s+', ' ', s).strip()
+    s = re.sub(r'\s+\*', ' *', s)
+    return s
+
+def _normalize_array_head_only(tname):
+    """
+    Apply normalize_for_ghidra() only to the part before the first '['.
+    Keeps the bracketed dimensions intact, e.g. '__int16 *[32]' -> 'short *[32]'.
+    """
+    s = tname.strip()
+    idx = s.find('[')
+    if idx == -1:
+        return normalize_for_ghidra(s)
+    head = s[:idx]
+    tail = s[idx:]          # includes the '['
+    head = normalize_for_ghidra(head)
+    return (head + tail).strip()
+
+def tinfo_to_str(tif):
+    """
+    Return a single-line C-ish declaration for the given tinfo_t (no identifier),
+    robust across IDA versions.
+    """
+    try:
+        # Newer IDA: returns Python str
+        return ida_typeinf.print_tinfo("", 0, 0,
+                                       ida_typeinf.PRTYPE_1LINE, tif, "", "")
+    except Exception:
+        try:
+            return tif.dstr()
+        except Exception:
+            return None
+
+def get_decl_from_tinfo_at(ea):
+    """
+    If a type is applied at EA, return its declaration string; else None.
+    """
+    tif = ida_typeinf.tinfo_t()
+    ok = False
+    try:
+        # IDA 8/9 style
+        ok = ida_nalt.get_tinfo(tif, ea)
+    except Exception:
+        try:
+            # Older compat
+            ok = ida_nalt.get_tinfo2(ea, tif)
+        except Exception:
+            ok = False
+    if ok:
+        return tinfo_to_str(tif)
+    return None
+
